						"\t} catch (e) {",
						"\t\treturn null;",
						"\t}",
						"}",
						"",
						"let wallStage = \"whole\";",
						"let crackTime = 0;",
						"let crackFromX = 0;",
						"let crackFromY = 0;",
						"let impactY = 400;",
						"let breakFace = 874;",
						"const shards = [];",
						"",
						"function dividerWall() {",
						"\tfor (let i = 0; i < grounds.length; i++) {",
