						"\t\t\tspinBody: true",
						"\t\t});",
						"\t}",
						"\tshards.length = 0;",
						"}",
						"",
						"function missVelocity(px, py, c, s) {",
						"\tconst marks = [",
						"\t\t{ x: 1520, y: 640 },",
						"\t\t{ x: 1240, y: 936 },",
						"\t\t{ x: 1280, y: 118 },",
						"\t\t{ x: 1122, y: 760 }",
						"\t];",
						"\tlet pick = marks[0];",
						"\tlet best = -2;",
						"\tfor (let i = 0; i < marks.length; i++) {",
						"\t\tconst dx = marks[i].x - px;",
						"\t\tconst dy = marks[i].y - py;",
						"\t\tconst len = Math.hypot(dx, dy) || 1;",
						"\t\tconst dot = (dx / len) * c + (dy / len) * s;",
						"\t\tif (dot > best) {",
						"\t\t\tbest = dot;",
						"\t\t\tpick = marks[i];",
						"\t\t}",
						"\t}",
						"\tconst dx = pick.x - px;",
						"\tconst dy = pick.y - py;",
						"\tconst len = Math.hypot(dx, dy) || 1;",
						"\tconst speed = Math.max(2800, len / 0.12);",
						"\treturn { x: (dx / len) * speed, y: (dy / len) * speed };",
						"}",
						"",
						"function checkLevelTransition() {",
						"\tif (levelChanging || isDead || playerManager.crushed || !player) return;",
