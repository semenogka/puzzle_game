						"\treturn keys.has(\"space\") || keys.has(\"keyw\") || keys.has(\"arrowup\");",
						"}",
						"",
						"globalThis.RuntimeLoop.set(() => {",
						"\tif (globalThis.TransitionManager.entryActive || isDead || levelChanging) return;",
						"\tif (!player || grounds.length === 0) return;",
						"",
						"\tconst deltaTime = runtime.dt;",
						"\tconst playerBox = player.getBoundingBox();",
						"",
						"\tconst isOnGlass = grounds.some(ground => {",
						"\t\tif (!ground) return false;",
						"",
						"\t\tconst hasGlassTag =",
						"\t\t\ttypeof ground.hasTag === \"function\"",
						"\t\t\t\t? ground.hasTag(\"glass\")",
						"\t\t\t\t: typeof ground.getAllTags === \"function\" &&",
						"\t\t\t\t\tground.getAllTags().includes(\"glass\");",
						"",
						"\t\tif (!hasGlassTag) return false;",
						"",
						"\t\tconst groundBox = ground.getBoundingBox();",
						"",
						"\t\tconst horizontalOverlap =",
						"\t\t\tplayerBox.right > groundBox.left &&",
						"\t\t\tplayerBox.left < groundBox.right;",
						"",
						"\t\tconst verticalDistance = Math.abs(playerBox.bottom - groundBox.top);",
						"",
						"\t\treturn horizontalOverlap && verticalDistance <= 3;",
						"\t});",
						"",
						"\tif (isOnGlass) {",
						"\t\twasOnGlass = true;",
						"\t\tglassTimer = glassDuration;",
						"\t} else if (wasOnGlass) {",
						"\t\tglassTimer -= deltaTime;",
						"",
						"\t\tif (glassTimer <= 0) {",
						"\t\t\twasOnGlass = false;",
						"\t\t\tglassTimer = 0;",
						"\t\t}",
						"\t}",
						"",
						"\tconst glassProtected = isOnGlass || wasOnGlass;",
						"\tcrushManager.active = !glassProtected;",
						"",
						"\tif (!lowerRoom && playerBox.top > 500 && playerBox.right < 860) lowerRoom = true;",
						"",
						"\tif (phase === \"free\") gravityManager.flipPlayer = true;",
						"",
						"\tgravityManager.preUpdate(deltaTime, grounds);",
						"",
						"\tconst physics = phase === \"play\" || phase === \"free\" || (phase === \"fly\" && !flyAimed);",
						"\tif (physics) {",
						"\t\tplayerManager.update(player, gravityManager.playerGrounds(grounds), [], deltaTime);",
						"\t} else {",
						"\t\tplayerManager.velocityX = 0;",
						"\t\tplayerManager.velocityY = 0;",
