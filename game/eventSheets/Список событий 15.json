						"\t\t\tbox = ground.getBoundingBox();",
						"\t\t} catch (e) {",
						"\t\t\tcontinue;",
						"\t\t}",
						"\t\tconst w = box.right - box.left;",
						"\t\tconst h = box.bottom - box.top;",
						"\t\tif (w < 90 && h > 700 && box.left > 820 && box.right < 980) return ground;",
						"\t}",
						"\treturn null;",
						"}",
						"",
						"function placeShard(shard, x, y, angle) {",
						"\tif (!shard.inst || shard.inst.destroyed) return;",
						"\ttry {",
						"\t\tshard.inst.x = x;",
						"\t\tshard.inst.y = y;",
						"\t\tshard.inst.angle = angle;",
						"\t} catch (e) {}",
						"}",
						"",
						"function beginCrack(atY) {",
						"\tif (wallStage !== \"whole\") return;",
						"\tconst wall = dividerWall();",
						"\tif (!wall) {",
						"\t\twallStage = \"done\";",
						"\t\treturn;",
						"\t}",
						"\tlet box;",
						"\ttry {",
						"\t\tbox = wall.getBoundingBox();",
						"\t} catch (e) {",
						"\t\twallStage = \"done\";",
						"\t\treturn;",
						"\t}",
						"\tbreakFace = box.left;",
						"\tconst top = box.top;",
						"\tconst bottom = box.bottom;",
						"\tconst cx = (box.left + box.right) / 2;",
						"\tconst thickness = Math.max(8, box.right - box.left);",
						"\tconst y = Math.max(top + 90, Math.min(bottom - 90, atY));",
						"\timpactY = y;",
						"\tconst hole = 228;",
						"\tconst holeTop = Math.max(top, y - hole / 2);",
						"\tconst holeBottom = Math.min(bottom, y + hole / 2);",
						"\tdestroyInst(wall);",
						"\tconst index = grounds.indexOf(wall);",
						"\tif (index >= 0) grounds.splice(index, 1);",
						"\tconst keep = (y0, y1) => {",
						"\t\tconst span = y1 - y0;",
						"\t\tif (span < 16) return;",
						"\t\tconst inst = makeChunk(cx, (y0 + y1) / 2, thickness, span);",
						"\t\tif (inst) grounds.push(inst);",
						"\t};",
						"\tkeep(top, holeTop);",
						"\tkeep(holeBottom, bottom);",
						"\tconst cols = 2;",
						"\tconst rows = 10;",
						"\tconst cellW = thickness / cols;",
						"\tconst cellH = (holeBottom - holeTop) / rows;",
						"\tfor (let r = 0; r < rows; r++) {",
						"\t\tfor (let c = 0; c < cols; c++) {",
						"\t\t\tconst px = box.left + (c + 0.5) * cellW;",
						"\t\t\tconst py = holeTop + (r + 0.5) * cellH;",
						"\t\t\tconst inst = makeChunk(px, py, Math.max(6, cellW - 1), Math.max(6, cellH - 1));",
						"\t\t\tif (!inst) continue;",
						"\t\t\tconst dist = Math.abs(py - y) + Math.abs(px - cx) * 0.4;",
						"\t\t\tshards.push({",
						"\t\t\t\tinst,",
						"\t\t\t\tx: px,",
						"\t\t\t\ty: py,",
						"\t\t\t\thomeX: px,",
						"\t\t\t\thomeY: py,",
						"\t\t\t\tdelay: dist / 340,",
						"\t\t\t\tloose: false,",
						"\t\t\t\tage: 0,",
						"\t\t\t\tvx: 0,",
						"\t\t\t\tvy: 0,",
						"\t\t\t\tang: 0,",
						"\t\t\t\tspin: (c - 0.5) * 2.2 + (r % 2 ? 0.6 : -0.6),",
						"\t\t\t\tradius: 50 + ((r * 3 + c) % 6) * 16,",
						"\t\t\t\torbit: r * 0.62 + c * 2.2,",
						"\t\t\t\trate: 3.1 + (r % 4) * 0.35",
						"\t\t\t});",
						"\t\t}",
						"\t}",
						"\twallStage = \"cracking\";",
						"\tcrackTime = 0;",
						"}",
						"",
						"function stepCrack(dt, px, py) {",
						"\tcrackTime += dt;",
						"\tfor (let i = 0; i < shards.length; i++) {",
						"\t\tconst shard = shards[i];",
						"\t\tif (!shard.loose) {",
						"\t\t\tconst dx = shard.homeX - px;",
						"\t\t\tconst dy = shard.homeY - py;",
						"\t\t\tconst hit = Math.abs(dx) < 70 && Math.abs(dy) < 84;",
						"\t\t\tif (crackTime > shard.delay) {",
						"\t\t\t\tconst grow = Math.min(1, (crackTime - shard.delay) / 0.4);",
						"\t\t\t\tconst amp = grow * grow * 2.2;",
						"\t\t\t\tconst wobble = Math.sin(crackTime * 18 + shard.orbit) * amp;",
						"\t\t\t\tshard.x = shard.homeX + wobble;",
						"\t\t\t\tshard.y = shard.homeY;",
						"\t\t\t\tshard.ang = wobble * 0.02;",
						"\t\t\t\tplaceShard(shard, shard.x, shard.y, shard.ang);",
						"\t\t\t}",
						"\t\t\tif (hit || crackTime > shard.delay + 0.42) {",
						"\t\t\t\tconst len = Math.hypot(dx, dy) || 1;",
						"\t\t\t\tshard.loose = true;",
						"\t\t\t\tshard.age = 0;",
						"\t\t\t\tshard.vx = 28 + (dx / len) * 18;",
						"\t\t\t\tshard.vy = (dy / len) * 16 + (shard.homeY - impactY) * 0.05;",
						"\t\t\t\tshard.homeX = shard.x;",
						"\t\t\t\tshard.homeY = shard.y;",
						"\t\t\t}",
						"\t\t} else {",
						"\t\t\tshard.age += dt;",
						"\t\t\tconst burst = 0.5;",
						"\t\t\tif (shard.age < burst) {",
						"\t\t\t\tconst u = shard.age / burst;",
						"\t\t\t\tconst ease = u * u * (3 - 2 * u);",
						"\t\t\t\tshard.x = shard.homeX + shard.vx * ease;",
						"\t\t\t\tshard.y = shard.homeY + shard.vy * ease;",
						"\t\t\t\tshard.ang = shard.spin * ease;",
						"\t\t\t} else {",
						"\t\t\t\tconst u = Math.min(1, (shard.age - burst) / 0.9);",
						"\t\t\t\tconst ease = u * u * (3 - 2 * u);",
						"\t\t\t\tshard.orbit += shard.rate * dt * ease;",
						"\t\t\t\tconst ox = vortex.x + Math.cos(shard.orbit) * shard.radius;",
						"\t\t\t\tconst oy = vortex.y + Math.sin(shard.orbit) * shard.radius;",
						"\t\t\t\tconst fromX = shard.homeX + shard.vx;",
						"\t\t\t\tconst fromY = shard.homeY + shard.vy;",
						"\t\t\t\tshard.x = fromX + (ox - fromX) * ease;",
						"\t\t\t\tshard.y = fromY + (oy - fromY) * ease;",
						"\t\t\t\tshard.ang = shard.spin * (1 + ease);",
						"\t\t\t}",
						"\t\t\tplaceShard(shard, shard.x, shard.y, shard.ang);",
						"\t\t}",
						"\t}",
						"\tif (crackTime >= 0.9) wallStage = \"done\";",
						"}",
						"",
						"function absorbShards() {",
						"\tfor (let i = 0; i < shards.length; i++) {",
						"\t\tconst shard = shards[i];",
						"\t\tif (!shard.inst || shard.inst.destroyed) continue;",
						"\t\tconst dx = shard.x - vortex.x;",
						"\t\tconst dy = shard.y - vortex.y;",
						"\t\triders.push({",
						"\t\t\tinst: shard.inst,",
						"\t\t\tx: shard.x,",
						"\t\t\ty: shard.y,",
						"\t\t\tradius: Math.max(44, Math.min(150, Math.hypot(dx, dy))),",
