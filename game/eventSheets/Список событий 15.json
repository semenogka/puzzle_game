						"\t\t}",
						"\t\tinst.width = w;",
						"\t\tinst.height = h;",
						"\t\tinst.x = x;",
						"\t\tinst.y = y;",
						"\t\tinst.angle = 0;",
						"\t\tinst.isVisible = true;",
						"\t\tinst.opacity = 1;",
						"\t\tif (inst.colorRgb) inst.colorRgb = [1, 1, 1];",
