{
	"name": "Список событий 5",
	"events": [
		{
			"eventType": "block",
			"conditions": [
				{
					"id": "on-start-of-layout",
					"objectClass": "System",
					"sid": 872546985155182
				}
			],
			"actions": [
				{
					"type": "script",
					"language": "javascript",
					"script": [
						"globalThis.__tickOwner = \"Level5\";",
						"globalThis.__layoutOwner = \"Level5\";",
						"",
						"",
						"const fakeBoxManager = globalThis.FakeBoxManager;",
						"",
						"if (!fakeBoxManager) {",
						"\tthrow new Error(\"fakeBoxManager не инициализирован\");",
						"}",
						"const grounds = runtime.objects.Ground.getAllInstances();",
						"const boxes = runtime.objects.Box.getAllInstances();",
						"",
						"const solidObstacles = [...grounds, ...boxes];",
						"const player = runtime.objects.Box2.getFirstInstance();",
						"const door = runtime.objects.Door.getFirstInstance();",
						"const realPlayer = runtime.objects.Player.getFirstInstance();",
						"",
						"if (!player) {",
						"\tthrow new Error(\"Объект Box2 не найден\");",
						"}",
						"",
						"const startOffsetX = door ? door.x - player.x : 0;",
						"const startOffsetY = door ? door.y - player.y : 0;",
						"",
						"let levelChanging = false;",
						"",
						"const nextLevels = {",
						"\t\"Level5\": \"Level6\"",
						"};",
						"",
						"fakeBoxManager.initialize(runtime);",
						"MusicManager.start(runtime, \"bgm.webm\");",
						"SoundManager.initialize(runtime);",
						"globalThis.TransitionManager.initialize(runtime, player);",
						"",
						"runtime.addEventListener(\"layoutstart\", () => {",
						"\tif (globalThis.__layoutOwner !== \"Level5\") return;",
						"\tlevelChanging = false;",
						"\tfakeBoxManager.reset();",
						"\tglobalThis.TransitionManager.reset();",
						"\tif (globalThis.TransitionManager.pendingEntry) {",
						"\t\tglobalThis.TransitionManager.startEntry(runtime, realPlayer);",
						"\t}",
						"});",
						"",
						"function checkLevelTransition(player) {",
						"\tif (levelChanging || !player || !door) return;",
						"",
						"\tconst playerBox = player.getBoundingBox();",
						"\tconst doorBox = door.getBoundingBox();",
						"",
						"\tconst overlaps =",
						"\t\tplayerBox.right > doorBox.left &&",
						"\t\tplayerBox.left < doorBox.right &&",
						"\t\tplayerBox.bottom > doorBox.top &&",
						"\t\tplayerBox.top < doorBox.bottom;",
						"",
						"\tif (!overlaps) return;",
						"",
						"\tconst nextLayout = nextLevels[runtime.layout.name];",
						"",
						"\tif (nextLayout) {",
						"\t\tlevelChanging = true;",
						"\t\tglobalThis.TransitionManager.start(runtime, player, nextLayout);",
						"\t}",
						"}",
						"",
						"runtime.addEventListener(\"tick\", () => {",
						"\tif (globalThis.__tickOwner !== \"Level5\") return;",
						"\tif (globalThis.TransitionManager.entryActive) {",
						"\t\tglobalThis.TransitionManager.update(runtime.dt);",
						"\t\treturn;",
						"\t}",
						"\tif (levelChanging) {",
						"\t\tglobalThis.TransitionManager.update(runtime.dt);",
						"\t\treturn;",
						"\t}",
						"",
						"\t",
						"",
						"\tfakeBoxManager.move(",
						"\t\tplayer,",
						"\t\tsolidObstacles,",
						"\t\truntime.dt",
						"\t);",
						"",
						"\tif (door) {",
						"\t\tdoor.x = player.x + startOffsetX;",
						"\t\tdoor.y = player.y + startOffsetY;",
						"\t}",
						"",
						"\tcheckLevelTransition(realPlayer);",
						"});",
						""
					]
				}
			],
			"sid": 461466862846202
		}
	],
	"sid": 785082213710556
}