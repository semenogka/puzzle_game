{
	"name": "Список событий 4",
	"events": [
		{
			"eventType": "block",
			"conditions": [
				{
					"id": "on-start-of-layout",
					"objectClass": "System",
					"sid": 754431434634305
				}
			],
			"actions": [
				{
					"type": "script",
					"language": "javascript",
					"script": [
						"",
						"const keys = new Set();",
						"",
						"let velocityY = 0;",
						"let onGround = false;",
						"let levelChanging = false;",
						"let movementX = 0;",
						"",
						"const speed = 600;",
						"const jumpForce = 1000;",
						"const gravity = 2000;",
						"",
						"const nextLevels = {",
						"\t\"Level4\": \"Level5\"",
						"};",
						"",
						"let frameData = [];",
						"let lastLogTime = 0;",
						"",
						"let frameFalling = false;",
						"let frameVelocityY = 0;",
						"let boxesInFrame = [];",
						"",
						"runtime.addEventListener(\"keydown\", e => {",
						"\tkeys.add(e.code.toLowerCase());",
						"\tkeys.add(e.key.toLowerCase());",
						"});",
						"",
						"runtime.addEventListener(\"keyup\", e => {",
						"\tkeys.delete(e.code.toLowerCase());",
						"\tkeys.delete(e.key.toLowerCase());",
						"});",
						"",
						"function initializeFrameDots() {",
						"\tframeData = [];",
						"",
						"\tconst frame = runtime.objects.Frame.getFirstInstance();",
						"\tif (!frame) return;",
						"",
						"\tconst step = 30;",
						"\tconst box = frame.getBoundingBox();",
						"\tconst dots = [];",
						"",
						"\tfor (let x = box.left + 25; x < box.right - 50; x += step) {",
						"\t\tfor (let y = box.top + 25; y < box.bottom - 50; y += step) {",
						"\t\t\tdots.push({ x, y });",
						"\t\t}",
						"\t}",
						"",
						"\tframeData.push({",
						"\t\tframeInstance: frame,",
						"\t\tdots: dots,",
						"\t\ttotalCount: dots.length",
						"\t});",
						"}",
						"",
						"function checkFrameFilling(boxes) {",
						"\tconst percentTextObject = runtime.objects.Percent.getFirstInstance();",
						"",
						"\tif (frameFalling) {",
						"\t\tif (percentTextObject) {",
						"\t\t\tpercentTextObject.text = \"100%\";",
						"\t\t}",
						"\t\treturn;",
						"\t}",
						"",
						"\tif (frameData.length === 0) return;",
						"",
						"\tframeData.forEach((data, index) => {",
						"\t\tlet filledCount = 0;",
						"\t\tconst currentBoxesInFrame = [];",
						"",
						"\t\tfor (const dot of data.dots) {",
						"\t\t\tfor (const box of boxes) {",
						"\t\t\t\tconst angleRad = box.angle;",
						"\t\t\t\tconst cos = Math.cos(-angleRad);",
						"\t\t\t\tconst sin = Math.sin(-angleRad);",
						"\t\t\t\tconst dx = dot.x - box.x;",
						"\t\t\t\tconst dy = dot.y - box.y;",
						"\t\t\t\tconst localX = dx * cos - dy * sin + box.x;",
						"\t\t\t\tconst localY = dx * sin + dy * cos + box.y;",
						"",
						"\t\t\t\tif (box.containsPoint(localX, localY)) {",
						"\t\t\t\t\tfilledCount++;",
						"",
						"\t\t\t\t\tif (!currentBoxesInFrame.includes(box)) {",
						"\t\t\t\t\t\tcurrentBoxesInFrame.push(box);",
						"\t\t\t\t\t}",
						"",
						"\t\t\t\t\tbreak;",
						"\t\t\t\t}",
						"\t\t\t}",
						"\t\t}",
						"",
						"\t\tlet percentage = data.totalCount > 0",
						"\t\t\t? Math.round((filledCount / data.totalCount) * 100)",
						"\t\t\t: 0;",
						"",
						"\t\tif (percentage > 0) {",
						"\t\t\tpercentage = Math.min(percentage + 5, 100);",
						"\t\t}",
						"",
						"\t\tif (percentTextObject) {",
						"\t\t\tpercentTextObject.text = percentage + \"%\";",
						"\t\t}",
						"",
						"\t\tconst currentTime = runtime.gameTime;",
						"",
						"\t\tif (currentTime - lastLogTime >= 0.5) {",
						"\t\t\tif (index === frameData.length - 1) {",
						"\t\t\t\tlastLogTime = currentTime;",
						"\t\t\t}",
						"\t\t}",
						"",
						"\t\tif (percentage >= 100) {",
						"\t\t\tframeFalling = true;",
						"\t\t\tboxesInFrame = currentBoxesInFrame;",
						"",
						"\t\t\tif (percentTextObject) {",
						"\t\t\t\tpercentTextObject.text = \"100%\";",
						"\t\t\t}",
						"",
						"\t\t\tboxesInFrame.forEach(box => {",
						"\t\t\t\tif (box.behaviors[\"Перетаскивание\"]) {",
						"\t\t\t\t\tbox.behaviors[\"Перетаскивание\"].isEnabled = false;",
						"\t\t\t\t}",
						"\t\t\t});",
						"\t\t}",
						"\t});",
						"}",
						"",
						"function handleFrameFalling(grounds, deltaTime) {",
						"\tif (!frameFalling) return;",
						"",
						"\tconst frame = runtime.objects.Frame.getFirstInstance();",
						"\tif (!frame) return;",
						"",
						"\tframeVelocityY += gravity * deltaTime;",
						"\tconst movementY = frameVelocityY * deltaTime;",
						"",
						"\tconst frameBox = frame.getBoundingBox();",
						"\tlet hitGround = false;",
						"\tlet targetY = frame.y + movementY;",
						"",
						"\tfor (const ground of grounds) {",
						"\t\tconst groundBox = ground.getBoundingBox();",
						"",
						"\t\tconst overlapsX =",
						"\t\t\tframeBox.right > groundBox.left &&",
						"\t\t\tframeBox.left < groundBox.right;",
						"",
						"\t\tif (",
						"\t\t\toverlapsX &&",
						"\t\t\tframeBox.bottom <= groundBox.top &&",
						"\t\t\tframeBox.bottom + movementY >= groundBox.top",
						"\t\t) {",
						"\t\t\tconst distanceToGround = groundBox.top - frameBox.bottom;",
						"\t\t\ttargetY = frame.y + distanceToGround;",
						"\t\t\thitGround = true;",
						"\t\t\tbreak;",
						"\t\t}",
						"\t}",
						"",
						"\tconst actualMoveY = targetY - frame.y;",
						"\tframe.y = targetY;",
						"",
						"\tboxesInFrame.forEach(box => {",
						"\t\tbox.y += actualMoveY;",
						"\t});",
						"",
						"\tif (hitGround) {",
						"\t\tframeVelocityY = 0;",
						"\t}",
						"}",
						"",
						"function restrictBoxesAboveLine(boxes, grounds) {",
						"\tif (frameFalling) return;",
						"",
						"\tconst line = runtime.objects.DottedLine.getFirstInstance();",
						"\tconst lineY = line ? line.y : Infinity;",
						"",
						"\tfor (const box of boxes) {",
						"\t\tif (box.y > lineY) {",
						"\t\t\tbox.y = lineY;",
						"\t\t}",
						"",
						"\t\tlet boxBBox = box.getBoundingBox();",
						"",
						"\t\tfor (const ground of grounds) {",
						"\t\t\tconst groundBBox = ground.getBoundingBox();",
						"",
						"\t\t\tconst overlapsX =",
						"\t\t\t\tboxBBox.right > groundBBox.left &&",
						"\t\t\t\tboxBBox.left < groundBBox.right;",
						"",
						"\t\t\tconst overlapsY =",
						"\t\t\t\tboxBBox.bottom > groundBBox.top &&",
						"\t\t\t\tboxBBox.top < groundBBox.bottom;",
						"",
						"\t\t\tif (overlapsX && overlapsY) {",
						"\t\t\t\tconst overlapWidth =",
						"\t\t\t\t\tMath.min(boxBBox.right, groundBBox.right) -",
						"\t\t\t\t\tMath.max(boxBBox.left, groundBBox.left);",
						"",
						"\t\t\t\tconst overlapHeight =",
						"\t\t\t\t\tMath.min(boxBBox.bottom, groundBBox.bottom) -",
						"\t\t\t\t\tMath.max(boxBBox.top, groundBBox.top);",
						"",
						"\t\t\t\tif (overlapWidth < overlapHeight) {",
						"\t\t\t\t\tif (box.x < ground.x) {",
						"\t\t\t\t\t\tbox.x -= overlapWidth + 2;",
						"\t\t\t\t\t} else {",
						"\t\t\t\t\t\tbox.x += overlapWidth + 2;",
						"\t\t\t\t\t}",
						"\t\t\t\t} else {",
						"\t\t\t\t\tif (box.y < ground.y) {",
						"\t\t\t\t\t\tbox.y -= overlapHeight + 2;",
						"\t\t\t\t\t} else {",
						"\t\t\t\t\t\tbox.y += overlapHeight + 2;",
						"\t\t\t\t\t}",
						"\t\t\t\t}",
						"",
						"\t\t\t\tif (",
						"\t\t\t\t\tbox.behaviors[\"Перетаскивание\"] &&",
						"\t\t\t\t\tbox.behaviors[\"Перетаскивание\"].isEnabled",
						"\t\t\t\t) {",
						"\t\t\t\t\tbox.behaviors[\"Перетаскивание\"].isEnabled = false;",
						"\t\t\t\t\tbox.behaviors[\"Перетаскивание\"].isEnabled = true;",
						"\t\t\t\t}",
						"",
						"\t\t\t\tboxBBox = box.getBoundingBox();",
						"\t\t\t}",
						"\t\t}",
						"\t}",
						"}",
						"",
						"function moveAndJump(deltaTime) {",
						"\tmovementX = 0;",
						"",
						"\tif (keys.has(\"keya\") || keys.has(\"arrowleft\")) {",
						"\t\tmovementX -= speed * deltaTime;",
						"\t}",
						"",
						"\tif (keys.has(\"keyd\") || keys.has(\"arrowright\")) {",
						"\t\tmovementX += speed * deltaTime;",
						"\t}",
						"",
						"\tif (",
						"\t\t(keys.has(\"space\") || keys.has(\"keyw\") || keys.has(\"arrowup\")) &&",
						"\t\tonGround",
						"\t) {",
						"\t\tvelocityY = -jumpForce;",
						"\t\tonGround = false;",
						"\t}",
						"}",
						"",
						"function resolvePlayerCollisionsX(player, solidObstacles, movementX) {",
						"\tif (movementX === 0) return;",
						"",
						"\tlet playerBox = player.getBoundingBox();",
						"",
						"\tfor (const obstacle of solidObstacles) {",
						"\t\tconst obstacleBox = obstacle.getBoundingBox();",
						"",
						"\t\tconst overlaps =",
						"\t\t\tplayerBox.right > obstacleBox.left &&",
						"\t\t\tplayerBox.left < obstacleBox.right &&",
						"\t\t\tplayerBox.bottom > obstacleBox.top &&",
						"\t\t\tplayerBox.top < obstacleBox.bottom;",
						"",
						"\t\tif (!overlaps) continue;",
						"",
						"\t\tif (movementX > 0) {",
						"\t\t\tplayer.x -= playerBox.right - obstacleBox.left;",
						"\t\t} else {",
						"\t\t\tplayer.x += obstacleBox.right - playerBox.left;",
						"\t\t}",
						"",
						"\t\tplayerBox = player.getBoundingBox();",
						"\t}",
						"}",
						"",
						"function movePlayerY(player, deltaTime) {",
						"\tvelocityY += gravity * deltaTime;",
						"",
						"\tconst previousBottom = player.getBoundingBox().bottom;",
						"",
						"\tplayer.y += velocityY * deltaTime;",
						"",
						"\treturn previousBottom;",
						"}",
						"",
						"function resolvePlayerCollisionsY(",
						"\tplayer,",
						"\tsolidObstacles,",
						"\tboxes,",
						"\tpreviousBottom",
						") {",
						"\tonGround = false;",
						"",
						"\tlet playerBox = player.getBoundingBox();",
						"",
						"\tfor (const obstacle of solidObstacles) {",
						"\t\tconst obstacleBox = obstacle.getBoundingBox();",
						"",
						"\t\tconst overlaps =",
						"\t\t\tplayerBox.right > obstacleBox.left &&",
						"\t\t\tplayerBox.left < obstacleBox.right &&",
						"\t\t\tplayerBox.bottom > obstacleBox.top &&",
						"\t\t\tplayerBox.top < obstacleBox.bottom;",
						"",
						"\t\tif (!overlaps) continue;",
						"",
						"\t\tif (velocityY >= 0 && previousBottom <= obstacleBox.top + 10) {",
						"\t\t\tplayer.y -= playerBox.bottom - obstacleBox.top;",
						"\t\t\tvelocityY = 0;",
						"\t\t\tonGround = true;",
						"",
						"\t\t\tenableOrDisableDragDrop(boxes, obstacle, false);",
						"\t\t} else if (velocityY < 0) {",
						"\t\t\tplayer.y += obstacleBox.bottom - playerBox.top;",
						"\t\t\tvelocityY = 0;",
						"\t\t}",
						"",
						"\t\tplayerBox = player.getBoundingBox();",
						"\t}",
						"",
						"\tfor (const box of boxes) {",
						"\t\tconst boxBox = box.getBoundingBox();",
						"",
						"\t\tconst overlaps =",
						"\t\t\tplayerBox.right > boxBox.left &&",
						"\t\t\tplayerBox.left < boxBox.right &&",
						"\t\t\tplayerBox.bottom > boxBox.top &&",
						"\t\t\tplayerBox.top < boxBox.bottom;",
						"",
						"\t\tif (!overlaps && !onGround) {",
						"\t\t\tenableOrDisableDragDrop(boxes, box, true);",
						"\t\t}",
						"\t}",
						"}",
						"",
						"function checkPlayerCollision(",
						"\tplayer,",
						"\tsolidObstacles,",
						"\tboxes,",
						"\tdeltaTime,",
						"\tmovementX",
						") {",
						"\tplayer.x += movementX;",
						"",
						"\tresolvePlayerCollisionsX(",
						"\t\tplayer,",
						"\t\tsolidObstacles,",
						"\t\tmovementX",
						"\t);",
						"",
						"\tconst previousBottom = movePlayerY(player, deltaTime);",
						"",
						"\tresolvePlayerCollisionsY(",
						"\t\tplayer,",
						"\t\tsolidObstacles,",
						"\t\tboxes,",
						"\t\tpreviousBottom",
						"\t);",
						"}",
						"",
						"function enableOrDisableDragDrop(boxes, obstacle, status) {",
						"\tif (frameFalling && boxesInFrame.includes(obstacle)) {",
						"\t\tif (obstacle.behaviors[\"Перетаскивание\"]) {",
						"\t\t\tobstacle.behaviors[\"Перетаскивание\"].isEnabled = false;",
						"\t\t}",
						"\t\treturn;",
						"\t}",
						"",
						"\tif (boxes.includes(obstacle)) {",
						"\t\tconst dragBehavior = obstacle.behaviors[\"Перетаскивание\"];",
						"",
						"\t\tif (dragBehavior) {",
						"\t\t\tdragBehavior.isEnabled = status;",
						"\t\t}",
						"\t}",
						"}",
						"",
						"function checkLevelTransition(player) {",
						"\tconst door = runtime.objects.Door.getFirstInstance();",
						"\tif (!door) return;",
						"",
						"\tconst playerBox = player.getBoundingBox();",
						"\tconst doorBox = door.getBoundingBox();",
						"",
						"\tconst overlaps =",
						"\t\tplayerBox.right > doorBox.left &&",
						"\t\tplayerBox.left < doorBox.right &&",
						"\t\tplayerBox.bottom > doorBox.top &&",
						"\t\tplayerBox.top < doorBox.bottom;",
						"",
						"\tif (overlaps) {",
						"\t\tconst currentLayout = runtime.layout.name;",
						"\t\tconst nextLayout = nextLevels[currentLayout];",
						"",
						"\t\tif (nextLayout) {",
						"\t\t\tlevelChanging = true;",
						"\t\t\truntime.goToLayout(nextLayout);",
						"\t\t}",
						"\t}",
						"}",
						"",
						"initializeFrameDots();",
						"",
						"runtime.addEventListener(\"tick\", () => {",
						"\tif (levelChanging) return;",
						"",
						"\tconst player = runtime.objects.Player.getFirstInstance();",
						"\tconst grounds = runtime.objects.Ground.getAllInstances();",
						"\tconst boxes = runtime.objects.Box.getAllInstances();",
						"",
						"\tif (!player || (grounds.length === 0 && boxes.length === 0)) return;",
						"",
						"\tconst deltaTime = runtime.dt;",
						"",
						"\tconst solidObstacles = [...grounds, ...boxes];",
						"",
						"\tconst frame = runtime.objects.Frame.getFirstInstance();",
						"\tif (frame) {",
						"\t\tsolidObstacles.push(frame);",
						"\t}",
						"",
						"\tmoveAndJump(deltaTime);",
						"",
						"\tcheckPlayerCollision(",
						"\t\tplayer,",
						"\t\tsolidObstacles,",
						"\t\tboxes,",
						"\t\tdeltaTime,",
						"\t\tmovementX",
						"\t);",
						"",
						"\thandleFrameFalling(grounds, deltaTime);",
						"\trestrictBoxesAboveLine(boxes, grounds);",
						"",
						"\tcheckLevelTransition(player);",
						"\tcheckFrameFilling(boxes);",
						"});",
						""
					]
				}
			],
			"sid": 958041845606488
		}
	],
	"sid": 172288399242656
}