{
	"name": "Список событий 4",
	"events": [
		{
			"eventType": "block",
			"conditions": [
				{
					"id": "on-start-of-layout",
					"objectClass": "System",
					"sid": 754431434634305
				}
			],
			"actions": [
				{
					"type": "script",
					"language": "javascript",
					"script": [
						"",
						"const playerManager = globalThis.PlayerManager;",
						"const boxManager = globalThis.BoxManager;",
						"const frameManager = globalThis.FrameManager;",
						"",
						"if (!playerManager || !boxManager || !frameManager) {",
						"\tthrow new Error(\"Один из менеджеров не инициализирован\");",
						"}",
						"const player = runtime.objects.Player.getFirstInstance();",
						"const grounds = runtime.objects.Ground.getAllInstances();",
						"const boxes = runtime.objects.Box.getAllInstances();",
						"const frame = runtime.objects.Frame.getFirstInstance();",
						"const lines = runtime.objects.DottedLine.getAllInstances();",
						"",
						"let levelChanging = false;",
						"let isDead = false;",
						"",
						"const fallLimit = 1200;",
						"",
						"const nextLevels = {",
						"\t\"Level4\": \"Level5\"",
						"};",
						"",
						"playerManager.initialize(runtime);",
						"MusicManager.start(runtime, \"bgm.webm\");",
						"SoundManager.initialize(runtime);",
						"frameManager.initialize(runtime);",
						"",
						"runtime.addEventListener(\"layoutstart\", () => {",
						"\tlevelChanging = false;",
						"\tisDead = false;",
						"",
						"\tboxManager.reset();",
						"});",
						"",
						"function checkLevelTransition(player) {",
						"\tif (levelChanging || isDead) return;",
						"",
						"\tconst door = runtime.objects.Door.getFirstInstance();",
						"\tif (!door) return;",
						"",
						"\tconst playerBox = player.getBoundingBox();",
						"\tconst doorBox = door.getBoundingBox();",
						"",
						"\tconst overlaps =",
						"\t\tplayerBox.right > doorBox.left &&",
						"\t\tplayerBox.left < doorBox.right &&",
						"\t\tplayerBox.bottom > doorBox.top &&",
						"\t\tplayerBox.top < doorBox.bottom;",
						"",
						"\tif (!overlaps) return;",
						"",
						"\tconst nextLayout = nextLevels[runtime.layout.name];",
						"",
						"\tif (nextLayout) {",
						"\t\tlevelChanging = true;",
						"\t\truntime.goToLayout(nextLayout);",
						"\t}",
						"}",
						"",
						"function checkPlayerFallUniversal(player) {",
						"\tif (!player || isDead || player.y <= fallLimit) return;",
						"",
						"\tisDead = true;",
						"\tlevelChanging = true;",
						"\tplayerManager.velocityY = 0;",
						"",
						"\truntime.goToLayout(runtime.layout.name);",
						"}",
						"",
						"runtime.addEventListener(\"tick\", () => {",
						"\tif (levelChanging || isDead) return;",
						"",
						"\t",
						"",
						"\tif (!player || (grounds.length === 0 && boxes.length === 0)) return;",
						"",
						"\tconst deltaTime = runtime.dt;",
						"",
						"\tconst playerGrounds = frame",
						"\t\t? [...grounds, frame]",
						"\t\t: grounds;",
						"",
						"\tplayerManager.update(",
						"\t\tplayer,",
						"\t\tplayerGrounds,",
						"\t\tboxes,",
						"\t\tdeltaTime",
						"\t);",
						"",
						"\tif (!frameManager.frameFalling) {",
						"\t\tboxManager.update(",
						"\t\t\tboxes,",
						"\t\t\tgrounds,",
						"\t\t\tplayer,",
						"\t\t\tlines,",
						"\t\t\tdeltaTime",
						"\t\t);",
						"\t}",
						"",
						"\tframeManager.update(",
						"\t\tboxes,",
						"\t\tgrounds,",
						"\t\tdeltaTime",
						"\t);",
						"",
						"\tcheckLevelTransition(player);",
						"\tcheckPlayerFallUniversal(player);",
						"});",
						""
					]
				}
			],
			"sid": 958041845606488
		}
	],
	"sid": 172288399242656
}
