{
	"name": "Список событий 1",
	"events": [
		{
			"eventType": "block",
			"conditions": [
				{
					"id": "on-start-of-layout",
					"objectClass": "System",
					"sid": 307262942393426
				}
			],
			"actions": [
				{
					"type": "script",
					"language": "javascript",
					"script": [
						"const keys = new Set();",
						"",
						"let velocityY = 0;",
						"let onGround = false;",
						"let levelChanging = false;",
						"",
						"const speed = 600;",
						"const jumpForce = 1000;",
						"const gravity = 2000;",
						"",
						"const nextLevels = {",
						"\t\"Level1\": \"Level2\"",
						"}",
						"",
						"runtime.addEventListener(\"keydown\", e => {",
						"\tkeys.add(e.code.toLowerCase());",
						"\tkeys.add(e.key.toLowerCase());",
						"})",
						"",
						"runtime.addEventListener(\"keyup\", e => {",
						"\tkeys.delete(e.code.toLowerCase());",
						"\tkeys.delete(e.key.toLowerCase());",
						"})",
						"",
						"function handleMovement(player, deltaTime) {",
						"\tif (keys.has(\"keya\") || keys.has(\"arrowleft\")) {",
						"\t\tplayer.x -= speed * deltaTime;",
						"\t}",
						"",
						"\tif (keys.has(\"keyd\") || keys.has(\"arrowright\")) {",
						"\t\tplayer.x += speed * deltaTime;",
						"\t}",
						"}",
						"",
						"function handleJump() {",
						"\tif (",
						"\t\t(keys.has(\"space\") || keys.has(\"keyw\") || keys.has(\"arrowup\")) &&",
						"\t\tonGround",
						"\t) {",
						"\t\tvelocityY = -jumpForce;",
						"\t\tonGround = false;",
						"\t}",
						"}",
						"",
						"function checkGroundCollision(player, grounds, previousBottom, currentBottom) {",
						"\tonGround = false;",
						"",
						"\tfor (const ground of grounds) {",
						"\t\tconst groundTop = ground.y - ground.height / 2;",
						"",
						"\t\tconst overlapsX =",
						"\t\t\tplayer.x + player.width / 2 > ground.x - ground.width / 2 &&",
						"\t\t\tplayer.x - player.width / 2 < ground.x + ground.width / 2;",
						"",
						"\t\tif (",
						"\t\t\tvelocityY >= 0 &&",
						"\t\t\tpreviousBottom <= groundTop + 5 &&",
						"\t\t\tcurrentBottom >= groundTop &&",
						"\t\t\toverlapsX",
						"\t\t) {",
						"\t\t\tplayer.y = groundTop - player.height / 2;",
						"\t\t\tvelocityY = 0;",
						"\t\t\tonGround = true;",
						"\t\t\tbreak;",
						"\t\t}",
						"\t}",
						"}",
						"",
						"function checkLevelTransition(player) {",
						"\tif (player.x >= runtime.layout.width - 100) {",
						"\t\tconst currentLayout = runtime.layout.name;",
						"\t\tconst nextLayout = nextLevels[currentLayout];",
						"",
						"\t\tif (nextLayout) {",
						"\t\t\tlevelChanging = true;",
						"\t\t\truntime.goToLayout(nextLayout);",
						"\t\t}",
						"\t}",
						"}",
						"",
						"runtime.addEventListener(\"tick\", e => {",
						"\tif (levelChanging) return",
						"",
						"\tconst player = runtime.objects.Player.getFirstInstance();",
						"\tconst grounds = runtime.objects.Ground.getAllInstances();",
						"",
						"\tif (!player || grounds.length === 0) return",
						"",
						"\tconst deltaTime = runtime.dt;",
						"",
						"\thandleMovement(player, deltaTime);",
						"\thandleJump();",
						"",
						"\tconst previousBottom = player.y + player.height / 2;",
						"",
						"\tvelocityY += gravity * deltaTime;",
						"\tplayer.y += velocityY * deltaTime;",
						"",
						"\tconst currentBottom = player.y + player.height / 2;",
						"",
						"\tcheckGroundCollision(player, grounds, previousBottom, currentBottom);",
						"\tcheckLevelTransition(player);",
						"})",
						""
					]
				}
			],
			"sid": 433128184077273
		}
	],
	"sid": 387451652193475
}