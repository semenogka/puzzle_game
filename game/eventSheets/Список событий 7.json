{
	"name": "Список событий 7",
	"events": [
		{
			"eventType": "block",
			"conditions": [
				{
					"id": "on-start-of-layout",
					"objectClass": "System",
					"sid": 956626022315914
				}
			],
			"actions": [
				{
					"type": "script",
					"language": "javascript",
					"script": [
						"// ==========================================================================",
						"// Уровень 7: Инициализация и основные менеджеры",
						"// ==========================================================================",
						"const playerManager = globalThis.PlayerManager;",
						"const boxManager = globalThis.BoxManager;",
						"const soundManager = globalThis.SoundManager;",
						"const musicManager = globalThis.MusicManager;",
						"const transitionManager = globalThis.TransitionManager;",
						"const gameOverManager = globalThis.GameOverManager;",
						"",
						"if (!playerManager) {",
						"\tthrow new Error(\"PlayerManager не инициализирован\");",
						"}",
						"",
						"const player = runtime.objects.Player?.getFirstInstance();",
						"const allGroundsRaw = runtime.objects.Ground?.getAllInstances() || [];",
						"const lines = runtime.objects.DottedLine?.getAllInstances() || [];",
						"",
						"let levelChanging = false;",
						"let isDead = false;",
						"let doorCooldown = 0;",
						"let currentDoorZone = null;",
						"const fallLimit = 1800;",
						"",
						"const nextLevels = {",
						"\t\"Level7\": \"Level8\"",
						"};",
						"",
						"playerManager.initialize(runtime);",
						"musicManager?.start(runtime, \"bgm.webm\");",
						"soundManager?.initialize(runtime);",
						"transitionManager?.initialize(runtime, player);",
						"",
						"// ==========================================================================",
						"// Утилиты поиска по тегам",
						"// ==========================================================================",
						"function hasTag(inst, tag) {",
						"\tif (!inst || !tag) return false;",
						"\tconst lower = String(tag).toLowerCase();",
						"\tif (typeof inst.hasTag === \"function\" && inst.hasTag(tag)) return true;",
						"\tif (typeof inst.getAllTags === \"function\") {",
						"\t\tfor (const t of inst.getAllTags()) {",
						"\t\t\tif (String(t).toLowerCase() === lower) return true;",
						"\t\t}",
						"\t}",
						"\tconst raw = inst.tags ?? inst.tag;",
						"\tif (typeof raw === \"string\") {",
						"\t\tfor (const t of raw.split(/\\s+/)) {",
						"\t\t\tif (t.toLowerCase() === lower) return true;",
						"\t\t}",
						"\t} else if (Array.isArray(raw)) {",
						"\t\tfor (const t of raw) {",
						"\t\t\tif (String(t).toLowerCase() === lower) return true;",
						"\t\t}",
						"\t}",
						"\treturn false;",
						"}",
						"",
						"function getAllSceneInstances() {",
						"\tconst all = [];",
						"\tfor (const key in runtime.objects) {",
						"\t\ttry {",
						"\t\t\tconst cls = runtime.objects[key];",
						"\t\t\tif (cls && typeof cls.getAllInstances === \"function\") {",
						"\t\t\t\tconst list = cls.getAllInstances();",
						"\t\t\t\tfor (let i = 0; i < list.length; i++) {",
						"\t\t\t\t\tall.push(list[i]);",
						"\t\t\t\t}",
						"\t\t\t}",
						"\t\t} catch (e) {}",
						"\t}",
						"\treturn all;",
						"}",
						"",
						"const allSceneInstances = getAllSceneInstances();",
						"",
						"function findInstancesByTag(tag) {",
						"\tconst result = [];",
						"\tconst lower = String(tag).toLowerCase();",
						"\tfor (const inst of allSceneInstances) {",
						"\t\tif (hasTag(inst, lower)) {",
						"\t\t\tresult.push(inst);",
						"\t\t}",
						"\t}",
						"\treturn result;",
						"}",
						"",
						"function findInstanceByTag(tag, fallbackInst = null) {",
						"\tconst lower = String(tag).toLowerCase();",
						"\tfor (const inst of allSceneInstances) {",
						"\t\tif (hasTag(inst, lower)) {",
						"\t\t\treturn inst;",
						"\t\t}",
						"\t}",
						"\treturn fallbackInst;",
						"}",
						"",
						"// ==========================================================================",
						"// Двери уровня 7 (поиск по тегам door0, door1 / door, door2, door3, door4, door5)",
						"// ==========================================================================",
						"const door0 = findInstanceByTag(\"door0\");",
						"const door1 = findInstanceByTag(\"door1\") || findInstanceByTag(\"door\");",
						"const door2 = findInstanceByTag(\"door2\");",
						"const door3 = findInstanceByTag(\"door3\");",
						"const door4 = findInstanceByTag(\"door4\");",
						"const door5 = findInstanceByTag(\"door5\");",
						"",
						"// ==========================================================================",
						"// Занавески комнат 2, 3 и 4 — экземпляры объекта what с тегами",
						"// ==========================================================================",
						"const what1 = findInstanceByTag(\"what1\");",
						"const what2 = findInstanceByTag(\"what2\");",
						"const what3 = findInstanceByTag(\"what3\");",
						"",
						"// ==========================================================================",
						"// Ящики уровня 7 (поиск по тегам heavyBox, smallBox, box2, zeroGravBox, box)",
						"// ==========================================================================",
						"const heavyBox = findInstanceByTag(\"heavyBox\");",
						"let heavyBoxVy = 0;",
						"let heavyBoxBroken = false;",
						"let heavyBoxLifted = false;",
						"",
						"const smallBoxes = findInstancesByTag(\"smallBox\");",
						"const smallBoxStates = new Map();",
						"for (const sb of smallBoxes) {",
						"\tsb.isVisible = false;",
						"\tsmallBoxStates.set(sb, { active: false, vy: 0 });",
						"}",
						"",
						"const box2 = findInstanceByTag(\"box2\");",
						"const fake = findInstanceByTag(\"fake\", runtime.objects.Fake?.getFirstInstance());",
						"const box2StartX = box2 ? box2.x : 0;",
						"const box2StartY = box2 ? box2.y : 0;",
						"const fakeStartX = fake ? fake.x : 0;",
						"const fakeStartY = fake ? fake.y : 0;",
						"",
						"// Все ящики сцены: с тегами box, dotted, или из runtime.objects.Box",
						"const taggedBoxes = findInstancesByTag(\"box\");",
						"const dottedBoxes = findInstancesByTag(\"dotted\");",
						"const fallbackBoxes = runtime.objects.Box?.getAllInstances() || [];",
						"const allBoxesSet = new Set([...taggedBoxes, ...dottedBoxes, ...fallbackBoxes]);",
						"",
						"// Блок во 2-й комнате без гравитации (по тегу zeroGravBox / zeroGrav, либо по координатам)",
						"let zeroGravBox = findInstanceByTag(\"zeroGravBox\") || findInstanceByTag(\"zeroGrav\");",
						"if (!zeroGravBox) {",
						"\tfor (const b of allBoxesSet) {",
						"\t\tif (b.x > 1300 && b.x < 1600 && b.y < 450) {",
						"\t\t\tzeroGravBox = b;",
						"\t\t\tbreak;",
						"\t\t}",
						"\t}",
						"}",
						"if (zeroGravBox) allBoxesSet.add(zeroGravBox);",
						"const allBoxesRaw = Array.from(allBoxesSet);",
						"",
						"const groundMove = findInstanceByTag(\"groundMove\", runtime.objects.groundMove?.getFirstInstance());",
						"let groundMoveRemoved = false;",
						"",
						"const btnUnpressed = findInstanceByTag(\"ненажатая\", runtime.objects.ненажатая?.getFirstInstance());",
						"const btnPressed = findInstanceByTag(\"нажатая\", runtime.objects.нажатая?.getFirstInstance());",
						"let buttonActivated = false;",
						"if (btnPressed) btnPressed.isVisible = false;",
						"",
						"// Стекло над Door2",
						"const wholeGlass = findInstanceByTag(\"целое\", runtime.objects.целое?.getFirstInstance());",
						"const gx = wholeGlass ? wholeGlass.x : 1775.4;",
						"const gy = wholeGlass ? wholeGlass.y : 339.5;",
						"const gw = wholeGlass ? wholeGlass.width : 323.7;",
						"const gh = wholeGlass ? wholeGlass.height : 158.4;",
						"",
						"let glassStage1 = runtime.objects[\"чутьРазбитое\"]?.getFirstInstance();",
						"if (!glassStage1 && runtime.objects[\"чутьРазбитое\"]) {",
						"\ttry {",
						"\t\tglassStage1 = runtime.objects[\"чутьРазбитое\"].createInstance(0, gx, gy);",
						"\t\tif (glassStage1) {",
						"\t\t\tglassStage1.width = gw;",
						"\t\t\tglassStage1.height = gh;",
						"\t\t\tglassStage1.isVisible = false;",
						"\t\t}",
						"\t} catch (e) {}",
						"}",
						"",
						"let glassStage2 = runtime.objects[\"сильноРазбитое\"]?.getFirstInstance();",
						"if (!glassStage2 && runtime.objects[\"сильноРазбитое\"]) {",
						"\ttry {",
						"\t\tglassStage2 = runtime.objects[\"сильноРазбитое\"].createInstance(0, gx, gy);",
						"\t\tif (glassStage2) {",
						"\t\t\tglassStage2.width = gw;",
						"\t\t\tglassStage2.height = gh;",
						"\t\t\tglassStage2.isVisible = false;",
						"\t\t}",
						"\t} catch (e) {}",
						"}",
						"",
						"let activeGlass = wholeGlass;",
						"let glassHits = 0;",
						"let glassDestroyed = false;",
						"",
						"const letterY = findInstanceByTag(\"ы\", runtime.objects.ы?.getFirstInstance());",
						"const textRooms = runtime.objects.Текст5?.getAllInstances() || [];",
						"const textExit = textRooms.find(t => t.x < 960 && t.y >= 540 && t.text && t.text.includes(\"ходи\"));",
						"",
						"function disableBuiltInDrag(inst) {",
						"\tconst drag = inst?.behaviors?.[\"Перетаскивание\"];",
						"\tif (!drag) return;",
						"\tdrag.isEnabled = false;",
						"\tdrag.enabled = false;",
						"}",
						"disableBuiltInDrag(heavyBox);",
						"for (const sb of smallBoxes) disableBuiltInDrag(sb);",
						"disableBuiltInDrag(box2);",
						"disableBuiltInDrag(zeroGravBox);",
						"disableBuiltInDrag(letterY);",
						"",
						"// ==========================================================================",
						"// Ограничение движения heavyBox (комната 1: стены слева и справа, потолок и пол)",
						"// heavyBox физически не может выйти за пределы комнаты 1 или пройти сквозь стены",
						"// ==========================================================================",
						"function clampHeavyBoxPosition(targetX, targetY) {",
						"\tconst halfW = 243;",
						"\tconst halfH = 67;",
						"\t// Стены: слева x=55, справа x=945 (стена в комнату 2)",
						"\tlet cx = Math.max(55 + halfW, Math.min(945 - halfW, targetX));",
						"\t// Потолок: y=40",
						"\tlet cy = Math.max(40 + halfH, targetY);",
						"\t// Пол: над полочкой слева (cx - halfW < 198) пол на y=334, иначе нижний пол на y=517",
						"\tlet floorY = 517;",
						"\tif (cx - halfW < 198) {",
						"\t\tfloorY = 334;",
						"\t}",
						"\tconst maxCenterY = floorY - halfH;",
						"\tlet onFloor = false;",
						"\tif (cy >= maxCenterY) {",
						"\t\tcy = maxCenterY;",
						"\t\tonFloor = true;",
						"\t}",
						"\treturn { x: cx, y: cy, onFloor };",
						"}",
						"",
						"function pushOutOfGrounds(inst) {",
						"\tif (!inst) return;",
						"\tconst solids = getActiveGrounds();",
						"\tfor (let pass = 0; pass < 6; pass++) {",
						"\t\tconst bounds = inst.getBoundingBox();",
						"\t\tlet pushX = 0;",
						"\t\tlet pushY = 0;",
						"\t\tlet minOverlap = Infinity;",
						"\t\tlet hit = false;",
						"\t\tfor (let i = 0; i < solids.length; i++) {",
						"\t\t\tconst solid = solids[i];",
						"\t\t\tif (!solid || solid === inst) continue;",
						"\t\t\tconst solidBox = solid.getBoundingBox();",
						"\t\t\tconst overlapX1 = bounds.right - solidBox.left;",
						"\t\t\tconst overlapX2 = solidBox.right - bounds.left;",
						"\t\t\tconst overlapY1 = bounds.bottom - solidBox.top;",
						"\t\t\tconst overlapY2 = solidBox.bottom - bounds.top;",
						"\t\t\tif (overlapX1 <= 0 || overlapX2 <= 0 || overlapY1 <= 0 || overlapY2 <= 0) continue;",
						"\t\t\tconst overlapX = Math.min(overlapX1, overlapX2);",
						"\t\t\tconst overlapY = Math.min(overlapY1, overlapY2);",
						"\t\t\tif (overlapX < overlapY) {",
						"\t\t\t\tif (overlapX < minOverlap) {",
						"\t\t\t\t\tminOverlap = overlapX;",
						"\t\t\t\t\thit = true;",
						"\t\t\t\t\tpushX = overlapX1 < overlapX2 ? -overlapX1 : overlapX2;",
						"\t\t\t\t\tpushY = 0;",
						"\t\t\t\t}",
						"\t\t\t} else if (overlapY < minOverlap) {",
						"\t\t\t\tminOverlap = overlapY;",
						"\t\t\t\thit = true;",
						"\t\t\t\tpushX = 0;",
						"\t\t\t\tpushY = overlapY1 < overlapY2 ? -overlapY1 : overlapY2;",
						"\t\t\t}",
						"\t\t}",
						"\t\tif (!hit) break;",
						"\t\tinst.x += pushX;",
						"\t\tinst.y += pushY;",
						"\t}",
						"}",
						"",
						"// ==========================================================================",
						"// Строгое ограничение: smallBox может пройти во 2-ю комнату ТОЛЬКО через дырку groundMove",
						"// ==========================================================================",
						"function clampSmallBoxMovement(currentX, currentY, targetX, targetY) {",
						"\tlet cx = targetX;",
						"\tlet cy = targetY;",
						"",
						"\t// Внешние границы стен и потолка",
						"\tif (cx < 95) cx = 95;",
						"\tif (cx > 1870) cx = 1870;",
						"\tif (cy < 75) cy = 75;",
						"",
						"\t// Пол: в комнатах 1 и 2 пол на y = 480 (кроме зоны над стеклом / проемом Door2)",
						"\tif (cx < 1620 && cy > 480) {",
						"\t\tcy = 480;",
						"\t}",
						"",
						"\t// Стена между комнатой 1 (x < 945) и комнатой 2 (x > 945)",
						"\t// Дырка находится строго на высоте groundMove: y от 75 до 285",
						"\tconst holeMinY = 75;",
						"\tconst holeMaxY = 285;",
						"\tconst wallX = 945;",
						"\tconst margin = 35; // полуширина smallBox",
						"",
						"\t// 1. Пока кнопка не нажата — проход закрыт полностью",
						"\tif (!groundMoveRemoved) {",
						"\t\tif (currentX < wallX && cx > wallX - margin) cx = wallX - margin;",
						"\t\tif (currentX >= wallX && cx < wallX + margin) cx = wallX + margin;",
						"\t} else {",
						"\t\t// 2. Кнопка нажата: пронести можно ТОЛЬКО через дырку (y от 75 до 285).",
						"\t\t// Ниже дырки (cy > holeMaxY || currentY > holeMaxY) — глухая стена!",
						"\t\tif (cy > holeMaxY || currentY > holeMaxY) {",
						"\t\t\tif (currentX < wallX && cx > wallX - margin) cx = wallX - margin;",
						"\t\t\tif (currentX >= wallX && cx < wallX + margin) cx = wallX + margin;",
						"\t\t}",
						"\t}",
						"",
						"\treturn { x: cx, y: cy };",
						"}",
						"",
						"// ==========================================================================",
						"// Универсальное перетаскивание мышью / тачем",
						"// ==========================================================================",
						"let isPointerDown = false;",
						"let pointerLayerX = 0;",
						"let pointerLayerY = 0;",
						"let draggedObject = null;",
						"let dragOffsetX = 0;",
						"let dragOffsetY = 0;",
						"",
						"function updatePointerCoords(e) {",
						"\tif (!e) return;",
						"\tconst layer = runtime.layout.getLayer(0);",
						"\tif (layer && typeof layer.cssPxToLayer === \"function\" && e.clientX !== undefined) {",
						"\t\ttry {",
						"\t\t\tconst pt = layer.cssPxToLayer(e.clientX, e.clientY);",
						"\t\t\tpointerLayerX = pt[0];",
						"\t\t\tpointerLayerY = pt[1];",
						"\t\t\treturn;",
						"\t\t} catch (err) {}",
						"\t}",
						"\tif (e.clientX !== undefined) {",
						"\t\tpointerLayerX = e.clientX;",
						"\t\tpointerLayerY = e.clientY;",
						"\t}",
						"}",
						"",
						"function getMouseStatus() {",
						"\ttry {",
						"\t\tif (runtime.mouse && typeof runtime.mouse.getMouseX === \"function\") {",
						"\t\t\tconst down = typeof runtime.mouse.isMouseButtonDown === \"function\" ? runtime.mouse.isMouseButtonDown(0) : false;",
						"\t\t\treturn { x: runtime.mouse.getMouseX(0), y: runtime.mouse.getMouseY(0), down };",
						"\t\t}",
						"\t\tconst mInst = runtime.objects.Мышь?.getFirstInstance();",
						"\t\tif (mInst && typeof mInst.getMouseX === \"function\") {",
						"\t\t\tconst down = typeof mInst.isMouseButtonDown === \"function\" ? mInst.isMouseButtonDown(0) : false;",
						"\t\t\treturn { x: mInst.getMouseX(0), y: mInst.getMouseY(0), down };",
						"\t\t}",
						"\t} catch (e) {}",
						"\treturn null;",
						"}",
						"",
						"function tryStartDrag(px, py) {",
						"\tif (isDead || levelChanging) return false;",
						"",
						"\t// 1. heavyBox (комната 1)",
						"\tif (heavyBox && !heavyBoxBroken && heavyBox.isVisible !== false) {",
						"\t\tconst b = heavyBox.getBoundingBox();",
						"\t\tif (px >= b.left && px <= b.right && py >= b.top && py <= b.bottom) {",
						"\t\t\tdraggedObject = heavyBox;",
						"\t\t\tdragOffsetX = heavyBox.x - px;",
						"\t\t\tdragOffsetY = heavyBox.y - py;",
						"\t\t\theavyBoxVy = 0;",
						"\t\t\theavyBoxLifted = true;",
						"\t\t\treturn true;",
						"\t\t}",
						"\t}",
						"",
						"\t// 2. smallBox",
						"\tfor (const sb of smallBoxes) {",
						"\t\tif (sb.isVisible) {",
						"\t\t\tconst b = sb.getBoundingBox();",
						"\t\t\tif (px >= b.left && px <= b.right && py >= b.top && py <= b.bottom) {",
						"\t\t\t\tdraggedObject = sb;",
						"\t\t\t\tdragOffsetX = sb.x - px;",
						"\t\t\t\tdragOffsetY = sb.y - py;",
						"\t\t\t\tconst st = smallBoxStates.get(sb);",
						"\t\t\t\tif (st) st.vy = 0;",
						"\t\t\t\treturn true;",
						"\t\t\t}",
						"\t\t}",
						"\t}",
						"",
						"\t// 3. zeroGravBox (комната 2)",
						"\tif (zeroGravBox && zeroGravBox.isVisible !== false) {",
						"\t\tconst b = zeroGravBox.getBoundingBox();",
						"\t\tif (px >= b.left && px <= b.right && py >= b.top && py <= b.bottom) {",
						"\t\t\tdraggedObject = zeroGravBox;",
						"\t\t\tdragOffsetX = zeroGravBox.x - px;",
						"\t\t\tdragOffsetY = zeroGravBox.y - py;",
						"\t\t\treturn true;",
						"\t\t}",
						"\t}",
						"",
						"\t// 4. Box2 (комната 3)",
						"\t// Клик СТРОГО в хитбокс box2. Если поверх лежит другой блок - box2 не брать!",
						"\tif (box2 && box2.isVisible !== false) {",
						"\t\tconst b = box2.getBoundingBox();",
						"\t\tif (px >= b.left && px <= b.right && py >= b.top && py <= b.bottom) {",
						"\t\t\tlet coveredByOther = false;",
						"\t\t\tfor (const other of allBoxesRaw) {",
						"\t\t\t\tif (!other || other === box2 || other.isVisible === false) continue;",
						"\t\t\t\tconst ob = other.getBoundingBox();",
						"\t\t\t\tif (px >= ob.left && px <= ob.right && py >= ob.top && py <= ob.bottom) {",
						"\t\t\t\t\tcoveredByOther = true;",
						"\t\t\t\t\tbreak;",
						"\t\t\t\t}",
						"\t\t\t}",
						"\t\t\tlet anyDragging = false;",
						"\t\t\tfor (const other of allBoxesRaw) {",
						"\t\t\t\tif (other && other !== box2 && other.behaviors?.[\"Перетаскивание\"]?.isDragging) {",
						"\t\t\t\t\tanyDragging = true;",
						"\t\t\t\t\tbreak;",
						"\t\t\t\t}",
						"\t\t\t}",
						"\t\t\tif (!coveredByOther && !anyDragging) {",
						"\t\t\t\tdraggedObject = box2;",
						"\t\t\t\tdragOffsetX = box2.x - px;",
						"\t\t\t\tdragOffsetY = box2.y - py;",
						"\t\t\t\treturn true;",
						"\t\t\t}",
						"\t\t}",
						"\t}",
						"",
						"\t// 5. Буква Ы",
						"\tif (letterY && letterY.isVisible !== false) {",
						"\t\tconst b = letterY.getBoundingBox();",
						"\t\tif (px >= b.left && px <= b.right && py >= b.top && py <= b.bottom) {",
						"\t\t\tdraggedObject = letterY;",
						"\t\t\tdragOffsetX = letterY.x - px;",
						"\t\t\tdragOffsetY = letterY.y - py;",
						"\t\t\treturn true;",
						"\t\t}",
						"\t}",
						"",
						"\treturn false;",
						"}",
						"",
						"// Перемещение перетаскиваемого объекта с жесткими границами комнат и стен",
						"function applyDragMove(targetX, targetY) {",
						"\tif (!draggedObject) return;",
						"",
						"\tif (draggedObject === heavyBox) {",
						"\t\t// heavyBox СТРОГО в комнате 1: не может выйти за x=55..945, y=40..517",
						"\t\tconst pos = clampHeavyBoxPosition(targetX, targetY);",
						"\t\theavyBox.x = pos.x;",
