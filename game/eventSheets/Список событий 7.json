					"script": [
						"// ==========================================================================",
						"// Уровень 7: Инициализация и основные менеджеры",
						"// ==========================================================================",
						"const playerManager = globalThis.PlayerManager;",
						"const boxManager = globalThis.BoxManager;",
						"const soundManager = globalThis.SoundManager;",
						"const musicManager = globalThis.MusicManager;",
						"const transitionManager = globalThis.TransitionManager;",
						"const gameOverManager = globalThis.GameOverManager;",
						"",
						"if (!playerManager) {",
						"\tthrow new Error(\"PlayerManager не инициализирован\");",
						"}",
						"",
						"const player = runtime.objects.Player?.getFirstInstance();",
						"const allGroundsRaw = runtime.objects.Ground?.getAllInstances() || [];",
						"const allBoxesRaw = runtime.objects.Box?.getAllInstances() || [];",
						"const lines = runtime.objects.DottedLine?.getAllInstances() || [];",
						"",
						"let levelChanging = false;",
						"let isDead = false;",
						"let doorCooldown = 0;",
						"let currentDoorZone = null;",
						"const fallLimit = 1800;",
						"",
						"const nextLevels = {",
						"\t\"Level7\": \"Level8\"",
						"};",
						"",
						"playerManager.initialize(runtime);",
						"musicManager?.start(runtime, \"bgm.webm\");",
						"soundManager?.initialize(runtime);",
						"transitionManager?.initialize(runtime, player);",
						"",
						"// ==========================================================================",
						"// Объекты уровня 7",
						"// ==========================================================================",
						"const door0 = runtime.objects.Door0?.getFirstInstance();",
						"const door1 = runtime.objects.Door?.getFirstInstance();",
						"const door2 = runtime.objects.Door2?.getFirstInstance();",
						"const door3 = runtime.objects.Door3?.getFirstInstance();",
						"const door4 = runtime.objects.Door4?.getFirstInstance();",
						"",
						"// Занавески комнат 2, 3 и 4",
						"const what1 = runtime.objects.what1?.getFirstInstance();",
						"const what2 = runtime.objects.what2?.getFirstInstance();",
						"const what3 = runtime.objects.what3?.getFirstInstance();",
						"",
						"const heavyBox = runtime.objects.heavyBox?.getFirstInstance();",
						"let heavyBoxVy = 0;",
						"let heavyBoxBroken = false;",
						"let heavyBoxLifted = false;",
						"",
						"const smallBoxes = runtime.objects.smallBox?.getAllInstances() || [];",
						"const smallBoxStates = new Map();",
						"for (const sb of smallBoxes) {",
						"\tsb.isVisible = false;",
						"\tsmallBoxStates.set(sb, { active: false, vy: 0 });",
						"}",
						"",
						"const groundMove = runtime.objects.groundMove?.getFirstInstance();",
						"let groundMoveRemoved = false;",
						"",
						"const btnUnpressed = runtime.objects.ненажатая?.getFirstInstance();",
						"const btnPressed = runtime.objects.нажатая?.getFirstInstance();",
						"let buttonActivated = false;",
						"if (btnPressed) btnPressed.isVisible = false;",
						"",
						"// Блок во 2-й комнате без гравитации",
						"const zeroGravBox = allBoxesRaw.find(b => b.x > 1300 && b.x < 1600 && b.y < 450);",
						"",
						"// Стекло над Door2",
						"const wholeGlass = runtime.objects.целое?.getFirstInstance();",
						"const gx = wholeGlass ? wholeGlass.x : 1775.4;",
						"const gy = wholeGlass ? wholeGlass.y : 339.5;",
						"const gw = wholeGlass ? wholeGlass.width : 323.7;",
						"const gh = wholeGlass ? wholeGlass.height : 158.4;",
						"",
						"let glassStage1 = runtime.objects[\"чутьРазбитое\"]?.getFirstInstance();",
						"if (!glassStage1 && runtime.objects[\"чутьРазбитое\"]) {",
						"\ttry {",
						"\t\tglassStage1 = runtime.objects[\"чутьРазбитое\"].createInstance(0, gx, gy);",
						"\t\tif (glassStage1) {",
						"\t\t\tglassStage1.width = gw;",
						"\t\t\tglassStage1.height = gh;",
						"\t\t\tglassStage1.isVisible = false;",
						"\t\t}",
						"\t} catch (e) {}",
						"}",
						"",
						"let glassStage2 = runtime.objects[\"сильноРазбитое\"]?.getFirstInstance();",
						"if (!glassStage2 && runtime.objects[\"сильноРазбитое\"]) {",
						"\ttry {",
						"\t\tglassStage2 = runtime.objects[\"сильноРазбитое\"].createInstance(0, gx, gy);",
						"\t\tif (glassStage2) {",
						"\t\t\tglassStage2.width = gw;",
						"\t\t\tglassStage2.height = gh;",
						"\t\t\tglassStage2.isVisible = false;",
						"\t\t}",
						"\t} catch (e) {}",
						"}",
						"",
						"let activeGlass = wholeGlass;",
						"let glassHits = 0;",
						"let glassDestroyed = false;",
						"",
						"const box2 = runtime.objects.Box2?.getFirstInstance();",
						"const fake = runtime.objects.Fake?.getFirstInstance();",
						"const box2StartX = box2 ? box2.x : 0;",
						"const box2StartY = box2 ? box2.y : 0;",
						"const fakeStartX = fake ? fake.x : 0;",
						"const fakeStartY = fake ? fake.y : 0;",
						"",
						"const letterY = runtime.objects.ы?.getFirstInstance();",
						"const textRooms = runtime.objects.Текст5?.getAllInstances() || [];",
						"const textExit = textRooms.find(t => t.x < 960 && t.y >= 540 && t.text && t.text.includes(\"ходи\"));",
						"",
						"function markDraggable(inst) {",
						"\tif (!inst) return;",
						"\tif (!inst.behaviors) inst.behaviors = {};",
						"\tif (!inst.behaviors[\"Перетаскивание\"]) {",
						"\t\tinst.behaviors[\"Перетаскивание\"] = { isEnabled: true, enabled: true };",
						"\t}",
						"}",
						"markDraggable(heavyBox);",
						"for (const sb of smallBoxes) markDraggable(sb);",
						"markDraggable(box2);",
						"markDraggable(zeroGravBox);",
						"markDraggable(letterY);",
						"",
						"// ==========================================================================",
						"// Физика препятствий: чтобы smallBox и блоки не проходили сквозь стены",
						"// ==========================================================================",
						"function moveWithSolidCollisions(inst, targetX, targetY, grounds) {",
						"\tconst startX = inst.x;",
						"\tconst startY = inst.y;",
						"\tconst dx = targetX - startX;",
						"\tconst dy = targetY - startY;",
						"\tconst dist = Math.hypot(dx, dy);",
						"\tconst steps = Math.max(1, Math.ceil(dist / 10));",
						"\tlet landedOnFloor = false;",
						"",
						"\tfor (let s = 1; s <= steps; s++) {",
						"\t\tinst.x = startX + (dx * s) / steps;",
						"\t\tinst.y = startY + (dy * s) / steps;",
						"",
						"\t\tfor (const g of grounds) {",
						"\t\t\tif (!g || g === inst || g.isVisible === false) continue;",
						"\t\t\tconst b = inst.getBoundingBox();",
						"\t\t\tconst gb = g.getBoundingBox();",
						"\t\t\tconst overlapX = Math.min(b.right, gb.right) - Math.max(b.left, gb.left);",
						"\t\t\tconst overlapY = Math.min(b.bottom, gb.bottom) - Math.max(b.top, gb.top);",
						"",
						"\t\t\tif (overlapX > 0 && overlapY > 0) {",
						"\t\t\t\tif (overlapX < overlapY) {",
						"\t\t\t\t\tconst dir = inst.x < g.x ? -1 : 1;",
						"\t\t\t\t\tinst.x += dir * overlapX;",
						"\t\t\t\t} else {",
						"\t\t\t\t\tconst dir = inst.y < g.y ? -1 : 1;",
						"\t\t\t\t\tinst.y += dir * overlapY;",
						"\t\t\t\t\tif (dir < 0) landedOnFloor = true;",
						"\t\t\t\t}",
						"\t\t\t}",
						"\t\t}",
						"\t}",
						"\treturn landedOnFloor;",
						"}",
						"",
						"// Строгое ограничение: smallBox может пройти во 2-ю комнату ТОЛЬКО через дырку groundMove",
						"function clampSmallBoxMovement(currentX, currentY, targetX, targetY) {",
						"\tlet cx = targetX;",
						"\tlet cy = targetY;",
						"",
						"\t// Внешние границы стен и потолка",
						"\tif (cx < 95) cx = 95;",
						"\tif (cx > 1870) cx = 1870;",
						"\tif (cy < 75) cy = 75;",
						"",
						"\t// Пол: в комнатах 1 и 2 пол на y = 480 (кроме зоны над стеклом / проемом Door2)",
						"\tif (cx < 1620 && cy > 480) {",
						"\t\tcy = 480;",
						"\t}",
						"",
						"\t// Стена между комнатой 1 (x < 945) и комнатой 2 (x > 945)",
						"\t// Дырка находится строго на высоте groundMove: y от 75 до 285",
						"\tconst holeMinY = 75;",
						"\tconst holeMaxY = 285;",
						"\tconst wallX = 945;",
						"\tconst margin = 35; // полуширина smallBox",
						"",
						"\t// 1. Пока кнопка не нажата — проход закрыт полностью",
						"\tif (!groundMoveRemoved) {",
						"\t\tif (currentX < wallX && cx > wallX - margin) cx = wallX - margin;",
						"\t\tif (currentX >= wallX && cx < wallX + margin) cx = wallX + margin;",
						"\t} else {",
						"\t\t// 2. Кнопка нажата: пронести можно ТОЛЬКО через дырку (y от 75 до 285).",
						"\t\t// Ниже дырки (cy > holeMaxY или currentY > holeMaxY) — глухая стена!",
						"\t\tif (cy > holeMaxY || currentY > holeMaxY) {",
						"\t\t\tif (currentX < wallX && cx > wallX - margin) cx = wallX - margin;",
						"\t\t\tif (currentX >= wallX && cx < wallX + margin) cx = wallX + margin;",
						"\t\t}",
						"\t}",
						"",
						"\treturn { x: cx, y: cy };",
						"}",
						"",
						"// ==========================================================================",
						"// Универсальное перетаскивание мышью / тачем",
						"// ==========================================================================",
						"let isPointerDown = false;",
						"let pointerLayerX = 0;",
						"let pointerLayerY = 0;",
						"let draggedObject = null;",
						"let dragOffsetX = 0;",
						"let dragOffsetY = 0;",
						"",
						"function updatePointerCoords(e) {",
						"\tif (!e) return;",
						"\tconst layer = runtime.layout.getLayer(0);",
						"\tif (layer && typeof layer.cssPxToLayer === \"function\" && e.clientX !== undefined) {",
						"\t\ttry {",
						"\t\t\tconst pt = layer.cssPxToLayer(e.clientX, e.clientY);",
						"\t\t\tpointerLayerX = pt[0];",
						"\t\t\tpointerLayerY = pt[1];",
						"\t\t\treturn;",
						"\t\t} catch (err) {}",
						"\t}",
						"\tif (e.clientX !== undefined) {",
						"\t\tpointerLayerX = e.clientX;",
						"\t\tpointerLayerY = e.clientY;",
						"\t}",
						"}",
						"",
						"function getMouseStatus() {",
						"\ttry {",
						"\t\tif (runtime.mouse && typeof runtime.mouse.getMouseX === \"function\") {",
						"\t\t\tconst down = typeof runtime.mouse.isMouseButtonDown === \"function\" ? runtime.mouse.isMouseButtonDown(0) : false;",
						"\t\t\treturn { x: runtime.mouse.getMouseX(0), y: runtime.mouse.getMouseY(0), down };",
						"\t\t}",
						"\t\tconst mInst = runtime.objects.Мышь?.getFirstInstance();",
						"\t\tif (mInst && typeof mInst.getMouseX === \"function\") {",
						"\t\t\tconst down = typeof mInst.isMouseButtonDown === \"function\" ? mInst.isMouseButtonDown(0) : false;",
						"\t\t\treturn { x: mInst.getMouseX(0), y: mInst.getMouseY(0), down };",
						"\t\t}",
						"\t} catch (e) {}",
						"\treturn null;",
						"}",
						"",
						"function tryStartDrag(px, py) {",
						"\tif (isDead || levelChanging) return false;",
						"",
						"\t// 1. heavyBox",
						"\tif (heavyBox && !heavyBoxBroken && heavyBox.isVisible !== false) {",
						"\t\tconst b = heavyBox.getBoundingBox();",
						"\t\tif (px >= b.left - 50 && px <= b.right + 50 && py >= b.top - 50 && py <= b.bottom + 50) {",
						"\t\t\tdraggedObject = heavyBox;",
						"\t\t\tdragOffsetX = heavyBox.x - px;",
						"\t\t\tdragOffsetY = heavyBox.y - py;",
						"\t\t\theavyBoxVy = 0;",
						"\t\t\theavyBoxLifted = true;",
						"\t\t\treturn true;",
						"\t\t}",
						"\t}",
						"",
						"\t// 2. smallBox",
						"\tfor (const sb of smallBoxes) {",
						"\t\tif (sb.isVisible) {",
						"\t\t\tconst b = sb.getBoundingBox();",
						"\t\t\tif (px >= b.left - 35 && px <= b.right + 35 && py >= b.top - 35 && py <= b.bottom + 35) {",
						"\t\t\t\tdraggedObject = sb;",
						"\t\t\t\tdragOffsetX = sb.x - px;",
						"\t\t\t\tdragOffsetY = sb.y - py;",
						"\t\t\t\tconst st = smallBoxStates.get(sb);",
						"\t\t\t\tif (st) st.vy = 0;",
						"\t\t\t\treturn true;",
						"\t\t\t}",
						"\t\t}",
						"\t}",
						"",
						"\t// 3. zeroGravBox (комната 2)",
						"\tif (zeroGravBox && zeroGravBox.isVisible !== false) {",
						"\t\tconst b = zeroGravBox.getBoundingBox();",
						"\t\tif (px >= b.left - 35 && px <= b.right + 35 && py >= b.top - 35 && py <= b.bottom + 35) {",
						"\t\t\tdraggedObject = zeroGravBox;",
						"\t\t\tdragOffsetX = zeroGravBox.x - px;",
						"\t\t\tdragOffsetY = zeroGravBox.y - py;",
						"\t\t\treturn true;",
						"\t\t}",
						"\t}",
						"",
						"\t// 4. Box2 (комната 3)",
						"\tif (box2 && box2.isVisible !== false) {",
						"\t\tconst b = box2.getBoundingBox();",
						"\t\tif (px >= b.left - 35 && px <= b.right + 35 && py >= b.top - 35 && py <= b.bottom + 35) {",
						"\t\t\tdraggedObject = box2;",
						"\t\t\tdragOffsetX = box2.x - px;",
						"\t\t\tdragOffsetY = box2.y - py;",
						"\t\t\treturn true;",
						"\t\t}",
						"\t}",
						"",
						"\t// 5. Буква Ы",
						"\tif (letterY && letterY.isVisible !== false) {",
						"\t\tconst b = letterY.getBoundingBox();",
						"\t\tif (px >= b.left - 40 && px <= b.right + 40 && py >= b.top - 40 && py <= b.bottom + 40) {",
						"\t\t\tdraggedObject = letterY;",
						"\t\t\tdragOffsetX = letterY.x - px;",
						"\t\t\tdragOffsetY = letterY.y - py;",
						"\t\t\treturn true;",
						"\t\t}",
						"\t}",
						"",
						"\treturn false;",
						"}",
						"",
						"runtime.addEventListener(\"pointerdown\", e => {",
						"\tisPointerDown = true;",
						"\tupdatePointerCoords(e);",
						"\ttryStartDrag(pointerLayerX, pointerLayerY);",
						"});",
						"",
						"runtime.addEventListener(\"pointermove\", e => {",
						"\tupdatePointerCoords(e);",
						"\tif (draggedObject && isPointerDown) {",
						"\t\tconst targetX = pointerLayerX + dragOffsetX;",
						"\t\tconst targetY = pointerLayerY + dragOffsetY;",
						"",
						"\t\tif (smallBoxes.includes(draggedObject)) {",
						"\t\t\tconst clamped = clampSmallBoxMovement(draggedObject.x, draggedObject.y, targetX, targetY);",
						"\t\t\tconst grounds = getActiveGrounds();",
						"\t\t\tmoveWithSolidCollisions(draggedObject, clamped.x, clamped.y, grounds);",
						"\t\t} else {",
						"\t\t\tdraggedObject.x = targetX;",
						"\t\t\tdraggedObject.y = targetY;",
						"\t\t}",
						"",
						"\t\tif (draggedObject === heavyBox) {",
						"\t\t\theavyBoxVy = 0;",
						"\t\t\theavyBoxLifted = true;",
						"\t\t}",
						"\t}",
						"});",
						"",
						"runtime.addEventListener(\"pointerup\", () => {",
						"\tisPointerDown = false;",
						"\tif (draggedObject === heavyBox) {",
						"\t\theavyBoxVy = 0;",
						"\t\theavyBoxLifted = true;",
						"\t}",
						"\tdraggedObject = null;",
						"});",
						"",
						"function isOverlapping(instA, instB) {",
						"\tif (!instA || !instB || !instA.isVisible || !instB.isVisible) return false;",
						"\tconst bA = instA.getBoundingBox();",
						"\tconst bB = instB.getBoundingBox();",
						"\treturn bA.right > bB.left && bA.left < bB.right && bA.bottom > bB.top && bA.top < bB.bottom;",
						"}",
						"",
						"function getActiveGrounds() {",
						"\tconst current = [];",
						"\tfor (const g of allGroundsRaw) {",
						"\t\tif (g === groundMove && groundMoveRemoved) continue;",
						"\t\tif (g.isVisible !== false) current.push(g);",
						"\t}",
						"\tif (fake && fake.isVisible !== false) current.push(fake);",
						"\treturn current;",
						"}",
						"",
						"// Проверка касания стекла smallBox",
						"function isHittingGlass(sb) {",
						"\tif (glassDestroyed || !activeGlass) return false;",
						"\tconst sBox = sb.getBoundingBox();",
						"\tconst gBox = activeGlass.getBoundingBox();",
						"\tconst overlapX = Math.min(sBox.right, gBox.right) - Math.max(sBox.left, gBox.left);",
						"\tconst touchingGlass = sBox.bottom >= gBox.top - 15 && sBox.top < gBox.bottom + 15;",
						"\treturn overlapX > 10 && touchingGlass;",
						"}",
						"",
						"// Открытие комнат (исчезновение занавесок what1, what2, what3)",
						"function updateRoomShrouds() {",
						"\tif (!player) return;",
						"\t// Комната 2 (справа сверху)",
						"\tif (what1 && what1.isVisible !== false) {",
						"\t\tif (player.x >= 940 && player.y < 540) {",
						"\t\t\twhat1.isVisible = false;",
						"\t\t}",
						"\t}",
						"\t// Комната 3 (справа снизу)",
						"\tif (what2 && what2.isVisible !== false) {",
						"\t\tif (player.x >= 940 && player.y >= 540) {",
						"\t\t\twhat2.isVisible = false;",
						"\t\t}",
						"\t}",
						"\t// Комната 4 (слева снизу)",
						"\tif (what3 && what3.isVisible !== false) {",
						"\t\tif (player.x < 940 && player.y >= 540) {",
						"\t\t\twhat3.isVisible = false;",
						"\t\t}",
						"\t}",
						"}",
						"",
						"// ==========================================================================",
						"// 1. Физика heavyBox (гравитация, раздавливание игрока и разбивание)",
						"// ==========================================================================",
						"function updateHeavyBox(dt, grounds) {",
						"\tif (!heavyBox || heavyBoxBroken) return;",
						"\tif (draggedObject === heavyBox) {",
						"\t\theavyBoxVy = 0;",
						"\t\theavyBoxLifted = true;",
						"\t\treturn;",
						"\t}",
						"",
						"\theavyBoxVy += 1600 * dt;",
						"\tif (heavyBoxVy > 1500) heavyBoxVy = 1500;",
						"\theavyBox.y += heavyBoxVy * dt;",
						"",
						"\tconst hBox = heavyBox.getBoundingBox();",
						"",
						"\t// Проверка: падение heavyBox на игрока (смерть \"Вас придавило\")",
						"\tif (!isDead && player) {",
						"\t\tconst pBox = player.getBoundingBox();",
						"\t\tconst overlapX = Math.min(hBox.right, pBox.right) - Math.max(hBox.left, pBox.left);",
						"\t\tconst overlapY = Math.min(hBox.bottom, pBox.bottom) - Math.max(hBox.top, pBox.top);",
						"",
						"\t\tif (overlapX > 20 && overlapY > 10 && hBox.top < pBox.top + 20 && hBox.bottom > pBox.top + 10) {",
						"\t\t\tisDead = true;",
						"\t\t\tlevelChanging = true;",
						"\t\t\tplayerManager.velocityX = 0;",
						"\t\t\tplayerManager.velocityY = 0;",
						"\t\t\tgameOverManager?.show(runtime, player, \"Вас придавило\");",
						"\t\t\treturn;",
						"\t\t}",
						"\t}",
						"",
						"\t// Столкновение с полом",
						"\tfor (const g of grounds) {",
						"\t\tif (g === heavyBox || !g.isVisible) continue;",
						"\t\tconst gBox = g.getBoundingBox();",
						"\t\tconst overlapX = Math.min(hBox.right, gBox.right) - Math.max(hBox.left, gBox.left);",
						"\t\tconst overlapY = Math.min(hBox.bottom, gBox.bottom) - Math.max(hBox.top, gBox.top);",
						"",
						"\t\tif (overlapX > 6 && overlapY > 0 && hBox.bottom >= gBox.top && hBox.top < gBox.top) {",
						"\t\t\theavyBox.y -= overlapY;",
						"\t\t\tif (heavyBoxVy > 250 && heavyBoxLifted) {",
						"\t\t\t\tbreakHeavyBox();",
						"\t\t\t\treturn;",
						"\t\t\t}",
						"\t\t\theavyBoxVy = 0;",
						"\t\t}",
						"\t}",
						"}",
						"",
						"function breakHeavyBox() {",
						"\theavyBoxBroken = true;",
						"\theavyBox.isVisible = false;",
						"\tsoundManager?.play(\"frameFall\");",
						"",
						"\tfor (const sb of smallBoxes) {",
						"\t\tsb.isVisible = true;",
						"\t\tconst st = smallBoxStates.get(sb) || {};",
						"\t\tst.active = true;",
						"\t\tst.vy = -60 - Math.random() * 120;",
						"\t\tsmallBoxStates.set(sb, st);",
