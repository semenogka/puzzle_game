{
	"name": "Список событий 2",
	"events": [
		{
			"eventType": "block",
			"conditions": [
				{
					"id": "on-start-of-layout",
					"objectClass": "System",
					"sid": 406365057670748
				}
			],
			"actions": [
				{
					"type": "script",
					"language": "javascript",
					"script": [
						"globalThis.__tickOwner = \"Level2\";",
						"globalThis.__layoutOwner = \"Level2\";",
						"",
						"",
						"const playerManager = globalThis.PlayerManager;",
						"",
						"if (!playerManager) {",
						"\tthrow new Error(\"PlayerManager не инициализирован\");",
						"}",
						"",
						"const player = runtime.objects.Player.getFirstInstance();",
						"const grounds = runtime.objects.Ground.getAllInstances();",
						"",
						"let levelChanging = false;",
						"let isDead = false;",
						"",
						"const fallLimit = 2200;",
						"",
						"const nextLevels = {",
						"\t\"Level2\": \"Level3\"",
						"};",
						"",
						"playerManager.initialize(runtime);",
						"MusicManager.start(runtime, \"bgm.webm\");",
						"SoundManager.initialize(runtime);",
						"globalThis.TransitionManager.initialize(runtime, player);",
						"",
						"runtime.addEventListener(\"layoutstart\", () => {",
						"\tif (globalThis.__layoutOwner !== \"Level2\") return;",
						"\tlevelChanging = false;",
						"\tisDead = false;",
						"\tglobalThis.TransitionManager.reset();",
						"\tif (globalThis.TransitionManager.pendingEntry) {",
						"\t\tglobalThis.TransitionManager.startEntry(runtime, player);",
						"\t}",
						"});",
						"",
						"function checkLevelTransition() {",
						"\tif (levelChanging || isDead || !player) return;",
						"",
						"\tconst door = runtime.objects.Door.getFirstInstance();",
						"\tif (!door) return;",
						"",
						"\tconst doorBox = door.getBoundingBox();",
						"\tconst playerBox = player.getBoundingBox();",
						"",
						"\tconst overlaps =",
						"\t\tplayerBox.right > doorBox.left &&",
						"\t\tplayerBox.left < doorBox.right &&",
						"\t\tplayerBox.bottom > doorBox.top &&",
						"\t\tplayerBox.top < doorBox.bottom;",
						"",
						"\tif (!overlaps) return;",
						"",
						"\tconst nextLayout = nextLevels[runtime.layout.name];",
						"",
						"\tif (nextLayout) {",
						"\t\tlevelChanging = true;",
						"\t\tplayerManager.velocityY = 0;",
						"\t\tglobalThis.TransitionManager.start(runtime, player, nextLayout);",
						"\t}",
						"}",
						"",
						"function checkPlayerFallUniversal() {",
						"\tif (isDead || !player || player.y <= fallLimit) return;",
						"",
						"\tisDead = true;",
						"\tplayerManager.velocityY = 0;",
						"",
						"\tglobalThis.TransitionManager.pendingEntry = false;",
						"\t\truntime.goToLayout(runtime.layout.name);",
						"}",
						"",
						"runtime.addEventListener(\"tick\", () => {",
						"\tif (globalThis.__tickOwner !== \"Level2\") return;",
						"\tif (globalThis.TransitionManager.entryActive) {",
						"\t\tglobalThis.TransitionManager.update(runtime.dt);",
						"\t\treturn;",
						"\t}",
						"\tif (isDead) return;",
						"\tif (levelChanging) {",
						"\t\tglobalThis.TransitionManager.update(runtime.dt);",
						"\t\treturn;",
						"\t}",
						"",
						"\tif (!player || grounds.length === 0) return;",
						"",
						"\tplayerManager.update(",
						"\t\tplayer,",
						"\t\tgrounds,",
						"\t\t[],",
						"\t\truntime.dt",
						"\t);",
						"",
						"\tcheckLevelTransition();",
						"\tcheckPlayerFallUniversal();",
						"});",
						""
					]
				}
			],
			"sid": 739632905409720
		}
	],
	"sid": 515024242776027
}