{
	"name": "Список событий 13",
	"events": [
		{
			"eventType": "block",
			"conditions": [
				{
					"id": "on-start-of-layout",
					"objectClass": "System",
					"sid": 807817491682608
				}
			],
			"actions": [
				{
					"type": "script",
					"language": "javascript",
					"script": [
						"const playerManager = globalThis.PlayerManager;",
						"const gravityManager = globalThis.GravityManager;",
						"const fallManager = globalThis.FallManager;",
						"const musicManager = globalThis.MusicManager;",
						"const soundManager = globalThis.SoundManager;",
						"const transitionManager = globalThis.TransitionManager;",
						"const effectManager = globalThis.EffectManager;",
						"",
						"if (!playerManager || !gravityManager || !fallManager) {",
						"\tthrow new Error(\"Один из менеджеров не инициализирован\");",
						"}",
						"",
						"const player = runtime.objects.Player?.getFirstInstance();",
						"const grounds = runtime.objects.Ground?.getAllInstances() || [];",
						"const door = runtime.objects.Door?.getFirstInstance();",
						"const lock = runtime.objects[\"замок\"]?.getFirstInstance();",
						"const button = runtime.objects[\"ненажатая\"]?.getFirstInstance();",
						"const bullet = runtime.objects[\"пуля\"]?.getFirstInstance();",
						"const cannon = runtime.objects[\"пушка\"]?.getFirstInstance();",
						"",
						"let levelChanging = false;",
						"let isDead = false;",
						"let buttonPressed = false;",
						"let doorUnlocked = !lock;",
						"let bulletActive = false;",
						"let bulletVy = 0;",
						"",
						"const bulletSpeedX = 560;",
						"const bulletGravity = 550;",
						"const bulletMaxVy = 650;",
						"const bulletStartX = bullet ? bullet.x : (cannon ? cannon.x + 35 : 147);",
						"const bulletStartY = bullet ? bullet.y : (cannon ? cannon.y - 4 : 440);",
						"const fallLimit = 1200;",
						"",
						"const nextLevels = {",
						"\t\"Level13\": \"Level14\"",
						"};",
						"",
						"if (bullet) bullet.isVisible = false;",
						"",
						"playerManager.initialize(runtime);",
						"musicManager?.start(runtime, \"bgm.webm\");",
						"soundManager?.initialize(runtime);",
						"transitionManager?.initialize(runtime, player);",
						"",
						"gravityManager.initialize(runtime, {",
						"\tflipPlayer: true,",
						"\tobjectTag: \"gravity\",",
						"\tobjectGravity: 1400,",
						"\tpushBoxes: false",
						"});",
						"gravityManager.bind(player);",
						"",
						"function overlaps(a, b, pad = 0) {",
						"\tif (!a || !b || a.isVisible === false || b.isVisible === false) return false;",
						"\tconst ba = a.getBoundingBox();",
						"\tconst bb = b.getBoundingBox();",
						"\treturn ba.right + pad > bb.left &&",
						"\t       ba.left - pad < bb.right &&",
						"\t       ba.bottom + pad > bb.top &&",
						"\t       ba.top - pad < bb.bottom;",
						"}",
						"",
						"function spawnBullet() {",
						"\tif (!bullet) return;",
						"\tbullet.x = bulletStartX;",
						"\tbullet.y = bulletStartY;",
						"\tbullet.isVisible = true;",
						"\tbulletVy = 0;",
						"\tbulletActive = true;",
						"\teffectManager?.lift(runtime, bullet);",
						"\tsoundManager?.play(\"jump\");",
						"}",
						"",
						"function updateButton() {",
						"\tif (buttonPressed || !button || !player) return;",
						"\tif (!overlaps(player, button, 6)) return;",
						"\tbuttonPressed = true;",
						"\tbutton.isVisible = false;",
						"\teffectManager?.button(runtime, button);",
						"\tspawnBullet();",
						"}",
						"",
						"function updateBullet(dt) {",
						"\tif (!bulletActive || !bullet) return;",
						"\tconst sign = gravityManager.playerSign === -1 ? -1 : 1;",
						"\tbullet.x += bulletSpeedX * dt;",
						"\tbulletVy += bulletGravity * sign * dt;",
						"\tif (bulletVy > bulletMaxVy) bulletVy = bulletMaxVy;",
						"\tif (bulletVy < -bulletMaxVy) bulletVy = -bulletMaxVy;",
						"\tbullet.y += bulletVy * dt;",
						"\tbullet.angle = Math.atan2(bulletVy, bulletSpeedX);",
						"",
						"\tif (!isDead && player && overlaps(bullet, player)) {",
						"\t\tisDead = true;",
						"\t\tlevelChanging = true;",
						"\t\tbulletActive = false;",
						"\t\tbullet.isVisible = false;",
						"\t\tplayerManager.velocityX = 0;",
						"\t\tplayerManager.velocityY = 0;",
						"\t\teffectManager?.spike(runtime, player);",
						"\t\tglobalThis.GameOverManager?.show(runtime, player, \"Вас подстрелили\");",
						"\t\treturn;",
						"\t}",
						"",
						"\tif (!doorUnlocked && lock && overlaps(bullet, lock, 6)) {",
						"\t\tdoorUnlocked = true;",
						"\t\tlock.isVisible = false;",
						"\t\tbulletActive = false;",
						"\t\tbullet.isVisible = false;",
						"\t\teffectManager?.impact(runtime, lock, sign);",
						"\t\tsoundManager?.play(\"frameFall\");",
						"\t\treturn;",
						"\t}",
						"",
						"\tfor (const g of grounds) {",
						"\t\tif (overlaps(bullet, g)) {",
						"\t\t\tbulletActive = false;",
						"\t\t\tbullet.isVisible = false;",
						"\t\t\teffectManager?.impact(runtime, bullet, sign);",
						"\t\t\tsoundManager?.play(\"frameFall\");",
						"\t\t\treturn;",
						"\t\t}",
						"\t}",
						"}",
						"",
						"function checkLevelTransition() {",
						"\tif (levelChanging || isDead || playerManager.crushed || !player || !door) return;",
						"\tif (!doorUnlocked) return;",
						"\tif (!overlaps(player, door)) return;",
						"\tif (gravityManager.holdsDoor(player)) return;",
						"\tconst nextLayout = nextLevels[runtime.layout.name];",
						"\tif (!nextLayout) return;",
						"\tlevelChanging = true;",
						"\tplayerManager.velocityX = 0;",
						"\tplayerManager.velocityY = 0;",
						"\ttransitionManager?.start(runtime, player, nextLayout);",
						"}",
						"",
						"globalThis.RuntimeLoop.set(() => {",
						"\tif (transitionManager?.entryActive || isDead || levelChanging) return;",
						"\tif (!player || grounds.length === 0) return;",
						"",
						"\tconst deltaTime = Math.min(runtime.dt, 0.05);",
						"\tgravityManager.preUpdate(deltaTime, grounds);",
						"\tplayerManager.update(player, grounds, [], deltaTime);",
						"\tgravityManager.postUpdate(player, grounds);",
						"",
						"\tupdateButton();",
						"\tupdateBullet(deltaTime);",
						"\tcheckLevelTransition();",
						"",
						"\tisDead = fallManager.checkPlayerFall(",
						"\t\truntime,",
						"\t\tglobalThis.GameOverManager,",
						"\t\tplayerManager,",
						"\t\tisDead,",
						"\t\tplayer,",
						"\t\tfallLimit",
						"\t);",
						"});"
					]
				}
			],
			"sid": 706087684413953
		}
	],
	"sid": 415236550958641
}