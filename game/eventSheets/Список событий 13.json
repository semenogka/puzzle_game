{
	"name": "Список событий 13",
	"events": [
		{
			"eventType": "block",
			"conditions": [
				{
					"id": "on-start-of-layout",
					"objectClass": "System",
					"sid": 807817491682608
				}
			],
			"actions": [
				{
					"type": "script",
					"language": "javascript",
					"script": [
						"const playerManager = globalThis.PlayerManager;",
						"const gravityManager = globalThis.GravityManager;",
						"const fallManager = globalThis.FallManager;",
						"const spikeManager = globalThis.SpikeManager;",
						"const crushManager = globalThis.CrushManager;",
						"",
						"if (!playerManager || !gravityManager || !fallManager || !spikeManager || !crushManager) {",
						"\tthrow new Error(\"Один из менеджеров не инициализирован\");",
						"}",
						"",
						"crushManager.active = true;",
						"",
						"const player = runtime.objects.Player.getFirstInstance();",
						"const grounds = runtime.objects.Ground.getAllInstances();",
						"",
						"let levelChanging = false;",
						"let isDead = false;",
						"",
						"const fallLimit = 1200;",
						"",
						"const nextLevels = {",
						"\t\"Level11\": \"Level12\"",
						"};",
						"",
						"playerManager.initialize(runtime);",
						"MusicManager.start(runtime, \"bgm.webm\");",
						"SoundManager.initialize(runtime);",
						"spikeManager.initialize(runtime);",
						"globalThis.TransitionManager.initialize(runtime, player);",
						"",
						"gravityManager.initialize(runtime, {",
						"\tflipPlayer: false,",
						"\tobjectTag: \"gravity\",",
						"\tobjectGravity: 1400,",
						"\tpushBoxes: true",
						"});",
						"",
						"gravityManager.bind(player);",
						"",
						"function checkLevelTransition() {",
						"\tif (levelChanging || isDead || playerManager.crushed || !player) return;",
						"",
						"\tconst door = runtime.objects.Door.getFirstInstance();",
						"\tif (!door) return;",
						"",
						"\tconst doorBox = door.getBoundingBox();",
						"\tconst playerBox = player.getBoundingBox();",
						"",
						"\tconst overlaps =",
						"\t\tplayerBox.right > doorBox.left &&",
						"\t\tplayerBox.left < doorBox.right &&",
						"\t\tplayerBox.bottom > doorBox.top &&",
						"\t\tplayerBox.top < doorBox.bottom;",
						"",
						"\tif (!overlaps) return;",
						"\tif (globalThis.GravityManager?.holdsDoor(player)) return;",
						"",
						"\tconst nextLayout = nextLevels[runtime.layout.name];",
						"\tif (!nextLayout) return;",
						"",
						"\tlevelChanging = true;",
						"\tplayerManager.velocityX = 0;",
						"\tplayerManager.velocityY = 0;",
						"",
						"\tglobalThis.TransitionManager.start(runtime, player, nextLayout);",
						"}",
						"",
						"globalThis.RuntimeLoop.set(() => {",
						"\tif (globalThis.TransitionManager.entryActive || isDead || levelChanging) return;",
						"\tif (!player || grounds.length === 0) return;",
						"",
						"\tconst deltaTime = runtime.dt;",
						"",
						"\tconst playerGrounds = gravityManager.playerGrounds(grounds);",
						"",
						"\tgravityManager.preUpdate(deltaTime, grounds);",
						"",
						"\tplayerManager.update(",
						"\t\tplayer,",
						"\t\tplayerGrounds,",
						"\t\t[],",
						"\t\tdeltaTime",
						"\t);",
						"",
						"\tgravityManager.postUpdate(player, grounds);",
						"",
						"\tcheckLevelTransition();",
						"",
						"\tconst isOnGlass = playerGrounds.some(ground => {",
						"\t\tif (!ground) return false;",
						"",
						"\t\tif (typeof ground.hasTag === \"function\") {",
						"\t\t\treturn ground.hasTag(\"glass\");",
						"\t\t}",
						"",
						"\t\tif (typeof ground.getAllTags === \"function\") {",
						"\t\t\treturn ground.getAllTags().includes(\"glass\");",
						"\t\t}",
						"",
						"\t\treturn false;",
						"\t});",
						"",
						"\tif (!isOnGlass) {",
						"\t\tisDead = fallManager.checkPlayerFall(",
						"\t\t\truntime,",
						"\t\t\tglobalThis.GameOverManager,",
						"\t\t\tplayerManager,",
						"\t\t\tisDead,",
						"\t\t\tplayer,",
						"\t\t\tfallLimit",
						"\t\t);",
						"\t}",
						"",
						"\tif (spikeManager.update(runtime, player, deltaTime)) {",
						"\t\tisDead = true;",
						"\t\treturn;",
						"\t}",
						"});"
					]
				}
			],
			"sid": 706087684413953
		}
	],
	"sid": 415236550958641
}