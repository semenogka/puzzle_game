{
	"name": "Список событий 6",
	"events": [
		{
			"eventType": "block",
			"conditions": [
				{
					"id": "on-start-of-layout",
					"objectClass": "System",
					"sid": 788524551690426
				}
			],
			"actions": [
				{
					"type": "script",
					"language": "javascript",
					"script": [
						"",
						"const playerManager = globalThis.PlayerManager;",
						"const boxManager = globalThis.BoxManager;",
						"",
						"if (!playerManager || !boxManager) {",
						"\tthrow new Error(\"Один из менеджеров не инициализирован\");",
						"}",
						"const player = runtime.objects.Player.getFirstInstance();",
						"const grounds = runtime.objects.Ground.getAllInstances();",
						"const boxes = runtime.objects.Box.getAllInstances();",
						"const lines = runtime.objects.DottedLine.getAllInstances();",
						"const door = runtime.objects.Door.getFirstInstance();",
						"const fakeDoor = runtime.objects.FakeDoor.getFirstInstance();",
						"",
						"let doorBox;",
						"let fakeDoorBox;",
						"if (door && fakeDoor) {",
						"\tdoorBox = door.getBoundingBox();",
						"\tfakeDoorBox = fakeDoor.getBoundingBox();",
						"}",
						"",
						"let levelChanging = false;",
						"let isDead = false;",
						"",
						"let targetZoom = 1;       ",
						"let currentZoom = 1;      ",
						"const zoomSpeed = 2;      ",
						"const layer = runtime.layout.getLayer(0); ",
						"\t",
						"const fallLimit = 1200;",
						"",
						"const nextLevels = {",
						"\t\"Leve6\": \"Level1\"",
						"};",
						"",
						"playerManager.initialize(runtime);",
						"",
						"runtime.addEventListener(\"layoutstart\", () => {",
						"\tlevelChanging = false;",
						"\tisDead = false;",
						"\ttargetZoom = 1;",
						"\tcurrentZoom = 1;",
						"\tboxManager.reset();",
						"});",
						"",
						"function checkFakeDoorCollision() {",
						"\tif (levelChanging || isDead) return;",
						"",
						"\tif (!player) return;",
						"",
						"\tconst playerBox = player.getBoundingBox();",
						"",
						"\tconst overlaps =",
						"\t\tplayerBox.right > fakeDoorBox.left &&",
						"\t\tplayerBox.left < fakeDoorBox.right &&",
						"\t\tplayerBox.bottom > fakeDoorBox.top &&",
						"\t\tplayerBox.top < fakeDoorBox.bottom;",
						"",
						"\tif (!overlaps) return;",
						"",
						"\ttargetZoom = 0.6;",
						"\tfor (const box of boxes) {",
						"\t\tconst hasTag = (typeof box.hasTag === \"function\" && box.hasTag(\"fakeGround\")) || ",
						"\t\t\tbox.tags?.includes(\"fakeGround\") || ",
						"\t\t\tbox.tag === \"fakeGround\";",
						"",
						"\t\tif (hasTag) {",
						"\t\t\tconst behavior = box.behaviors[\"Перетаскивание\"] || box.behaviors[\"DragDrop\"];",
						"\t\t\tbehavior.isEnabled = true;",
						"\t\t\t",
						"\t\t\tif (box.animationName !== \"SquareBlueWithRed\") {",
						"\t\t\t\tif (typeof box.setAnimation === \"function\") {",
						"\t\t\t\t\tbox.setAnimation(\"SquareBlueWithRed\");",
						"\t\t\t\t} else {",
						"\t\t\t\t\tbox.animationName = \"SquareBlueWithRed\";",
						"\t\t\t\t}",
						"\t\t\t}",
						"\t\t}",
						"\t}",
						"}",
						"",
						"function checkLevelTransition() {",
						"\tif (levelChanging || isDead) return;",
						"",
						"\tif (!player) return;",
						"",
						"\tconst playerBox = player.getBoundingBox();",
						"",
						"\tconst overlaps =",
						"\t\tplayerBox.right > doorBox.left &&",
						"\t\tplayerBox.left < doorBox.right &&",
						"\t\tplayerBox.bottom > doorBox.top &&",
						"\t\tplayerBox.top < doorBox.bottom;",
						"",
						"\tif (!overlaps) return;",
						"",
						"\tconst nextLayout = nextLevels[runtime.layout.name];",
						"",
						"\tif (nextLayout) {",
						"\t\tlevelChanging = true;",
						"\t\tplayerManager.velocityY = 0;",
						"\t\truntime.goToLayout(nextLayout);",
						"\t}",
						"}",
						"",
						"function checkPlayerFallUniversal(player) {",
						"\tif (isDead || !player || player.y <= fallLimit) return;",
						"",
						"\tisDead = true;",
						"\tlevelChanging = true;",
						"\tplayerManager.velocityY = 0;",
						"",
						"\truntime.goToLayout(runtime.layout.name);",
						"}",
						"",
						"runtime.addEventListener(\"tick\", () => {",
						"\tif (levelChanging || isDead) return;",
						"",
						"\tif (!player || (grounds.length === 0 && boxes.length === 0)) return;",
						"",
						"\tconst deltaTime = runtime.dt;",
						"",
						"\tconst result = playerManager.update(",
						"\t\tplayer,",
						"\t\tgrounds,",
						"\t\tboxes,",
						"\t\tdeltaTime",
						"\t);",
						"",
						"\tboxManager.update(",
						"\t\tboxes,",
						"\t\tgrounds,",
						"\t\tplayer,",
						"\t\tlines,",
						"\t\tdeltaTime",
						"\t);",
						"\tcheckFakeDoorCollision();",
						"\tcheckLevelTransition();",
						"\tcheckPlayerFallUniversal(player);",
						"",
						"\tcurrentZoom += (targetZoom - currentZoom) * zoomSpeed * deltaTime;",
						"",
						"\tif (layer) {",
						"\t\tlayer.scale = currentZoom;",
						"\t}",
						"});",
						""
					]
				}
			],
			"sid": 336327915406422
		}
	],
	"sid": 512611895047946
}