{
	"name": "говно на память",
	"events": [
		{
			"eventType": "script",
			"language": "javascript",
			"script": [
				"const keys = new Set();",
				"",
				"let velocityY = 0;",
				"let onGround = false;",
				"let levelChanging = false;",
				"",
				"let draggedBox = null;",
				"let dragOffsetX = 0;",
				"let dragOffsetY = 0;",
				"",
				"let upperDoor = null;",
				"let linkedBox = null;",
				"",
				"let doorOffsetX = 0;",
				"let doorOffsetY = 0;",
				"",
				"const speed = 100;",
				"const jumpForce = 400;",
				"const gravity = 1200;",
				"",
				"const nextLevels = {",
				"    \"Level4\": \"Level5\"",
				"};",
				"",
				"// Проверка пересечения объектов",
				"function overlaps(a, b) {",
				"    const A = a.getBoundingBox();",
				"    const B = b.getBoundingBox();",
				"",
				"    return (",
				"        A.left < B.right &&",
				"        A.right > B.left &&",
				"        A.top < B.bottom &&",
				"        A.bottom > B.top",
				"    );",
				"}",
				"",
				"// Проверка столкновения с Ground",
				"function hitsGround(object) {",
				"    const grounds = runtime.objects.Ground.getAllInstances();",
				"",
				"    return grounds.some(ground => overlaps(object, ground));",
				"}",
				"",
				"// Проверка столкновения с препятствиями игрока",
				"function hitsPlayerObstacle(object) {",
				"    const grounds = runtime.objects.Ground.getAllInstances();",
				"    const boxes = runtime.objects.Box.getAllInstances();",
				"",
				"    return [...grounds, ...boxes].some(obstacle =>",
				"        overlaps(object, obstacle)",
				"    );",
				"}",
				"",
				"// Поиск верхней двери и привязка к боксу",
				"function setupDoorLink() {",
				"    const doors = runtime.objects.images.getAllInstances();",
				"    const boxes = runtime.objects.Box.getAllInstances();",
				"",
				"    if (doors.length < 2 || boxes.length === 0) {",
				"        return false;",
				"    }",
				"",
				"    // Выбираем дверь с наименьшей координатой Y",
				"    upperDoor = doors.reduce((a, b) => a.y < b.y ? a : b);",
				"",
				"    // Запоминаем бокс",
				"    linkedBox = boxes[0];",
				"",
				"    // Запоминаем исходное расстояние между боксом и дверью",
				"    doorOffsetX = upperDoor.x - linkedBox.x;",
				"    doorOffsetY = upperDoor.y - linkedBox.y;",
				"",
				"    return true;",
				"}",
				"",
				"// Синхронизация двери с боксом",
				"function updateDoorLink() {",
				"    if (!upperDoor || !linkedBox) {",
				"        return;",
				"    }",
				"",
				"    upperDoor.x = linkedBox.x + doorOffsetX;",
				"    upperDoor.y = linkedBox.y + doorOffsetY;",
				"}",
				"",
				"function moveBoxAxis(box, distance, axis) {",
				"    if (Math.abs(distance) < 0.001) return;",
				"",
				"    const direction = Math.sign(distance);",
				"    let remaining = Math.abs(distance);",
				"",
				"    const grounds = runtime.objects.Ground.getAllInstances();",
				"",
				"    while (remaining > 0) {",
				"        // Шаг не больше одного пикселя",
				"        const step = Math.min(1, remaining) * direction;",
				"",
				"        const oldX = box.x;",
				"        const oldY = box.y;",
				"",
				"        // Двигаем бокс",
				"        if (axis === \"x\") {",
				"            box.x += step;",
				"        } else {",
				"            box.y += step;",
				"        }",
				"",
				"        const boxBounds = box.getBoundingBox();",
				"",
				"        let collided = false;",
				"",
				"        for (const ground of grounds) {",
				"            const groundBounds = ground.getBoundingBox();",
				"",
				"            const intersects =",
				"                boxBounds.left < groundBounds.right &&",
				"                boxBounds.right > groundBounds.left &&",
				"                boxBounds.top < groundBounds.bottom &&",
				"                boxBounds.bottom > groundBounds.top;",
				"",
				"            if (intersects) {",
				"                collided = true;",
				"                break;",
				"            }",
				"        }",
				"",
				"        if (collided) {",
				"            // Возвращаем бокс в последнее допустимое положение",
				"            box.x = oldX;",
				"            box.y = oldY;",
				"            return;",
				"        }",
				"",
				"        remaining -= Math.abs(step);",
				"    }",
				"}",
				"",
				"",
				"// Клавиатура",
				"runtime.addEventListener(\"keydown\", e => {",
				"    keys.add(e.key.toLowerCase());",
				"});",
				"",
				"runtime.addEventListener(\"keyup\", e => {",
				"    keys.delete(e.key.toLowerCase());",
				"});",
				"",
				"// Начальная настройка",
				"runtime.addEventListener(\"beforeprojectstart\", () => {",
				"    setupDoorLink();",
				"});",
				"",
				"// Начало перетаскивания бокса",
				"runtime.addEventListener(\"pointerdown\", e => {",
				"    if (levelChanging) return;",
				"",
				"    const layer = runtime.layout.getLayer(0);",
				"",
				"    const mouseX = layer.cssToLayerX(e.clientX);",
				"    const mouseY = layer.cssToLayerY(e.clientY);",
				"",
				"    for (const box of runtime.objects.Box.getAllInstances()) {",
				"        const bounds = box.getBoundingBox();",
				"",
				"        if (",
				"            mouseX >= bounds.left &&",
				"            mouseX <= bounds.right &&",
				"            mouseY >= bounds.top &&",
				"            mouseY <= bounds.bottom",
				"        ) {",
				"            draggedBox = box;",
				"",
				"            dragOffsetX = box.x - mouseX;",
				"            dragOffsetY = box.y - mouseY;",
				"",
				"            // Если дверь ещё не привязана, попробуем привязать",
				"            if (!upperDoor || !linkedBox) {",
				"                setupDoorLink();",
				"            }",
				"",
				"            break;",
				"        }",
				"    }",
				"});",
				"",
				"// Перемещение бокса мышкой",
				"runtime.addEventListener(\"pointermove\", e => {",
				"    if (!draggedBox || levelChanging) return;",
				"",
				"    const layer = runtime.layout.getLayer(0);",
				"",
				"    const mouseX = layer.cssToLayerX(e.clientX);",
				"    const mouseY = layer.cssToLayerY(e.clientY);",
				"",
				"    const targetX = mouseX + dragOffsetX;",
				"    const targetY = mouseY + dragOffsetY;",
				"",
				"    moveBoxAxis(draggedBox, targetX - draggedBox.x, \"x\");",
				"    moveBoxAxis(draggedBox, targetY - draggedBox.y, \"y\");",
				"",
				"    updateDoorLink();",
				"});",
				"",
				"runtime.addEventListener(\"pointerup\", () => {",
				"    draggedBox = null;",
				"});",
				"",
				"// Игровой цикл",
				"runtime.addEventListener(\"tick\", e => {",
				"    if (levelChanging) return;",
				"",
				"    const player = runtime.objects.Player.getFirstInstance();",
				"",
				"    if (!player) return;",
				"",
				"    // Повторяем поиск, если привязка не удалась при запуске",
				"    if (!upperDoor || !linkedBox) {",
				"        setupDoorLink();",
				"    }",
				"",
				"    const dt = Math.min(runtime.dt, 1 / 30);",
				"",
				"    // Поддерживаем связь двери и бокса",
				"    updateDoorLink();",
				"",
				"    // Движение игрока по горизонтали",
				"    const direction =",
				"        (keys.has(\"d\") || keys.has(\"arrowright\") ? 1 : 0) -",
				"        (keys.has(\"a\") || keys.has(\"arrowleft\") ? 1 : 0);",
				"",
				"    const horizontalDistance = direction * speed * dt;",
				"",
				"    const horizontalSteps = Math.max(",
				"        1,",
				"        Math.ceil(Math.abs(horizontalDistance) / 4)",
				"    );",
				"",
				"    const horizontalStep = horizontalDistance / horizontalSteps;",
				"",
				"    for (let i = 0; i < horizontalSteps; i++) {",
				"        player.x += horizontalStep;",
				"",
				"        if (hitsPlayerObstacle(player)) {",
				"            player.x -= horizontalStep;",
				"            break;",
				"        }",
				"    }",
				"",
				"    // Прыжок",
				"    if (",
				"        (keys.has(\" \") || keys.has(\"w\") || keys.has(\"arrowup\")) &&",
				"        onGround",
				"    ) {",
				"        velocityY = -jumpForce;",
				"        onGround = false;",
				"    }",
				"",
				"    // Гравитация",
				"    velocityY += gravity * dt;",
				"",
				"    // Пошаговое вертикальное движение",
				"    const verticalDistance = velocityY * dt;",
				"",
				"    const verticalSteps = Math.max(",
				"        1,",
				"        Math.ceil(Math.abs(verticalDistance) / 4)",
				"    );",
				"",
				"    const verticalStep = verticalDistance / verticalSteps;",
				"",
				"    onGround = false;",
				"",
				"    for (let i = 0; i < verticalSteps; i++) {",
				"        player.y += verticalStep;",
				"",
				"        if (hitsPlayerObstacle(player)) {",
				"            player.y -= verticalStep;",
				"",
				"            if (velocityY > 0) {",
				"                onGround = true;",
				"            }",
				"",
				"            velocityY = 0;",
				"            break;",
				"        }",
				"    }",
				"",
				"    // Проверка контакта с верхней дверью",
				"    if (upperDoor && overlaps(player, upperDoor)) {",
				"        const nextLayout = nextLevels[runtime.layout.name];",
				"",
				"        if (nextLayout) {",
				"            levelChanging = true;",
				"            runtime.goToLayout(nextLayout);",
				"        }",
				"    }",
				"});"
			]
		}
	],
	"sid": 428854474768804
}