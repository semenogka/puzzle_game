{
	"name": "Список событий 3",
	"events": [
		{
			"eventType": "block",
			"conditions": [
				{
					"id": "on-start-of-layout",
					"objectClass": "System",
					"sid": 239527592965102
				}
			],
			"actions": [
				{
					"type": "script",
					"language": "javascript",
					"script": [
						"const playerManager = globalThis.PlayerManager;",
						"const boxManager = globalThis.BoxManager;",
						"const fallManager = globalThis.FallManager;",
						"",
						"if (!playerManager || !boxManager || !fallManager) {",
						"\tthrow new Error(\"Один из менеджеров не инициализирован\");",
						"}",
						"",
						"const player = runtime.objects.Player.getFirstInstance();",
						"const grounds = runtime.objects.Ground.getAllInstances();",
						"const boxes = runtime.objects.Box.getAllInstances();",
						"const lines = runtime.objects.DottedLine.getAllInstances();",
						"const door = runtime.objects.Door.getFirstInstance();",
						"let levelChanging = false;",
						"let isDead = false;",
						"",
						"const fallLimit = 1200;",
						"",
						"const nextLevels = {",
						"\t\"Level3\": \"Level4\"",
						"};",
						"",
						"playerManager.initialize(runtime);",
						"MusicManager.start(runtime, \"bgm.webm\");",
						"SoundManager.initialize(runtime);",
						"globalThis.TransitionManager.initialize(runtime, player);",
						"",
						"function checkLevelTransition() {",
						"\tif (levelChanging || isDead || playerManager.crushed) return;",
						"",
						"\tif (!door || !player) return;",
						"",
						"\tconst playerBox = player.getBoundingBox();",
						"\tconst doorBox = door.getBoundingBox();",
						"",
						"\tconst overlaps =",
						"\t\tplayerBox.right > doorBox.left &&",
						"\t\tplayerBox.left < doorBox.right &&",
						"\t\tplayerBox.bottom > doorBox.top &&",
						"\t\tplayerBox.top < doorBox.bottom;",
						"",
						"\tif (!overlaps) return;",
						"\tif (globalThis.GravityManager?.holdsDoor(player)) return;",
						"",
						"\tconst nextLayout = nextLevels[runtime.layout.name];",
						"",
						"\tif (nextLayout) {",
						"\t\tlevelChanging = true;",
						"\t\tplayerManager.velocityY = 0;",
						"\t\tglobalThis.TransitionManager.start(runtime, player, nextLayout);",
						"\t}",
						"}",
						"",
						"globalThis.RuntimeLoop.set(() => {",
						"\tif (globalThis.TransitionManager.entryActive || isDead || levelChanging) return;",
						"",
						"\tif (!player || (grounds.length === 0 && boxes.length === 0)) return;",
						"",
						"\tconst deltaTime = runtime.dt;",
						"",
						"\tconst result = playerManager.update(",
						"\t\tplayer,",
						"\t\tgrounds,",
						"\t\tboxes,",
						"\t\tdeltaTime",
						"\t);",
						"",
						"\tboxManager.update(",
						"\t\tboxes,",
						"\t\tgrounds,",
						"\t\tplayer,",
						"\t\tlines,",
						"\t\tdeltaTime",
						"\t);",
						"",
						"\tcheckLevelTransition();",
						"",
						"\tif (fallManager.checkPlayerFall(runtime, globalThis.GameOverManager, playerManager, isDead, player, fallLimit)) {",
						"\t\tisDead = true;",
						"\t\tlevelChanging = true;",
						"\t}",
						"});",
						""
					]
				}
			],
			"sid": 139123869015157
		}
	],
	"sid": 404297600729732
}