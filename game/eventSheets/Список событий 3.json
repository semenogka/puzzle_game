{
	"name": "Список событий 3",
	"events": [
		{
			"eventType": "block",
			"conditions": [
				{
					"id": "on-start-of-layout",
					"objectClass": "System",
					"sid": 239527592965102
				}
			],
			"actions": [
				{
					"type": "script",
					"language": "javascript",
					"script": [
						"",
						"const keys = new Set();",
						"",
						"let velocityY = 0;",
						"let onGround = false;",
						"let levelChanging = false;",
						"let movementX = 0;",
						"",
						"const speed = 600;",
						"const jumpForce = 1000;",
						"const gravity = 2000;",
						"",
						"const nextLevels = {",
						"\t\"Level3\": \"Level4\"",
						"};",
						"",
						"runtime.addEventListener(\"keydown\", e => {",
						"\tkeys.add(e.code.toLowerCase());",
						"\tkeys.add(e.key.toLowerCase());",
						"});",
						"",
						"runtime.addEventListener(\"keyup\", e => {",
						"\tkeys.delete(e.code.toLowerCase());",
						"\tkeys.delete(e.key.toLowerCase());",
						"});",
						"",
						"function moveAndJump(deltaTime) {",
						"\tmovementX = 0;",
						"",
						"\tif (keys.has(\"keya\") || keys.has(\"arrowleft\")) {",
						"\t\tmovementX -= speed * deltaTime;",
						"\t}",
						"",
						"\tif (keys.has(\"keyd\") || keys.has(\"arrowright\")) {",
						"\t\tmovementX += speed * deltaTime;",
						"\t}",
						"",
						"\tif (",
						"\t\t(keys.has(\"space\") || keys.has(\"keyw\") || keys.has(\"arrowup\")) &&",
						"\t\tonGround",
						"\t) {",
						"\t\tvelocityY = -jumpForce;",
						"\t\tonGround = false;",
						"\t}",
						"}",
						"",
						"function resolvePlayerCollisionsX(player, solidObstacles, movementX) {",
						"\tif (movementX === 0) return;",
						"",
						"\tlet playerBox = player.getBoundingBox();",
						"",
						"\tfor (const obstacle of solidObstacles) {",
						"\t\tconst obstacleBox = obstacle.getBoundingBox();",
						"",
						"\t\tconst overlaps =",
						"\t\t\tplayerBox.right > obstacleBox.left &&",
						"\t\t\tplayerBox.left < obstacleBox.right &&",
						"\t\t\tplayerBox.bottom > obstacleBox.top &&",
						"\t\t\tplayerBox.top < obstacleBox.bottom;",
						"",
						"\t\tif (!overlaps) continue;",
						"",
						"\t\tif (movementX > 0) {",
						"\t\t\tplayer.x -= playerBox.right - obstacleBox.left;",
						"\t\t} else {",
						"\t\t\tplayer.x += obstacleBox.right - playerBox.left;",
						"\t\t}",
						"",
						"\t\tplayerBox = player.getBoundingBox();",
						"\t}",
						"}",
						"",
						"function movePlayerY(player, deltaTime) {",
						"\tvelocityY += gravity * deltaTime;",
						"",
						"\tconst previousBottom = player.getBoundingBox().bottom;",
						"",
						"\tplayer.y += velocityY * deltaTime;",
						"",
						"\treturn previousBottom;",
						"}",
						"",
						"function resolvePlayerCollisionsY(player, solidObstacles, boxes, previousBottom) {",
						"\tonGround = false;",
						"",
						"\tlet playerBox = player.getBoundingBox();",
						"",
						"\tfor (const obstacle of solidObstacles) {",
						"\t\tconst obstacleBox = obstacle.getBoundingBox();",
						"",
						"\t\tconst overlaps =",
						"\t\t\tplayerBox.right > obstacleBox.left &&",
						"\t\t\tplayerBox.left < obstacleBox.right &&",
						"\t\t\tplayerBox.bottom > obstacleBox.top &&",
						"\t\t\tplayerBox.top < obstacleBox.bottom;",
						"",
						"\t\tif (!overlaps) continue;",
						"",
						"\t\tif (velocityY >= 0 && previousBottom <= obstacleBox.top + 10) {",
						"\t\t\tplayer.y -= playerBox.bottom - obstacleBox.top;",
						"\t\t\tvelocityY = 0;",
						"\t\t\tonGround = true;",
						"",
						"\t\t\tenableOrDisableDragDrop(boxes, obstacle, false);",
						"\t\t} else if (velocityY < 0) {",
						"\t\t\tplayer.y += obstacleBox.bottom - playerBox.top;",
						"\t\t\tvelocityY = 0;",
						"\t\t}",
						"",
						"\t\tplayerBox = player.getBoundingBox();",
						"\t}",
						"",
						"\tfor (const box of boxes) {",
						"\t\tconst boxBox = box.getBoundingBox();",
						"",
						"\t\tconst overlaps =",
						"\t\t\tplayerBox.right > boxBox.left &&",
						"\t\t\tplayerBox.left < boxBox.right &&",
						"\t\t\tplayerBox.bottom > boxBox.top &&",
						"\t\t\tplayerBox.top < boxBox.bottom;",
						"",
						"\t\tif (!overlaps && !onGround) {",
						"\t\t\tenableOrDisableDragDrop(boxes, box, true);",
						"\t\t}",
						"\t}",
						"}",
						"",
						"function checkPlayerCollision(player, solidObstacles, boxes, deltaTime, movementX) {",
						"\tplayer.x += movementX;",
						"",
						"\tresolvePlayerCollisionsX(",
						"\t\tplayer,",
						"\t\tsolidObstacles,",
						"\t\tmovementX",
						"\t);",
						"",
						"\tconst previousBottom = movePlayerY(player, deltaTime);",
						"",
						"\tresolvePlayerCollisionsY(",
						"\t\tplayer,",
						"\t\tsolidObstacles,",
						"\t\tboxes,",
						"\t\tpreviousBottom",
						"\t);",
						"}",
						"",
						"function restrictBoxesAboveGround(boxes, grounds) {",
						"\tfor (const box of boxes) {",
						"\t\tlet boxBBox = box.getBoundingBox();",
						"",
						"\t\tfor (const ground of grounds) {",
						"\t\t\tconst groundBBox = ground.getBoundingBox();",
						"",
						"\t\t\tconst overlapsX =",
						"\t\t\t\tboxBBox.right > groundBBox.left &&",
						"\t\t\t\tboxBBox.left < groundBBox.right;",
						"",
						"\t\t\tconst overlapsY =",
						"\t\t\t\tboxBBox.bottom > groundBBox.top &&",
						"\t\t\t\tboxBBox.top < groundBBox.bottom;",
						"",
						"\t\t\tif (overlapsX && overlapsY) {",
						"\t\t\t\tconst overlapWidth =",
						"\t\t\t\t\tMath.min(boxBBox.right, groundBBox.right) -",
						"\t\t\t\t\tMath.max(boxBBox.left, groundBBox.left);",
						"",
						"\t\t\t\tconst overlapHeight =",
						"\t\t\t\t\tMath.min(boxBBox.bottom, groundBBox.bottom) -",
						"\t\t\t\t\tMath.max(boxBBox.top, groundBBox.top);",
						"",
						"\t\t\t\tif (overlapWidth < overlapHeight) {",
						"\t\t\t\t\tif (box.x < ground.x) {",
						"\t\t\t\t\t\tbox.x -= overlapWidth + 2;",
						"\t\t\t\t\t} else {",
						"\t\t\t\t\t\tbox.x += overlapWidth + 2;",
						"\t\t\t\t\t}",
						"\t\t\t\t} else {",
						"\t\t\t\t\tif (box.y < ground.y) {",
						"\t\t\t\t\t\tbox.y -= overlapHeight + 2;",
						"\t\t\t\t\t} else {",
						"\t\t\t\t\t\tbox.y += overlapHeight + 2;",
						"\t\t\t\t\t}",
						"\t\t\t\t}",
						"",
						"\t\t\t\tconst dragBehavior = box.behaviors[\"Перетаскивание\"];",
						"",
						"\t\t\t\tif (dragBehavior && dragBehavior.isEnabled) {",
						"\t\t\t\t\tdragBehavior.isEnabled = false;",
						"\t\t\t\t\tdragBehavior.isEnabled = true;",
						"\t\t\t\t}",
						"",
						"\t\t\t\tboxBBox = box.getBoundingBox();",
						"\t\t\t}",
						"\t\t}",
						"\t}",
						"}",
						"",
						"function enableOrDisableDragDrop(boxes, obstacle, status) {",
						"\tif (boxes.includes(obstacle)) {",
						"\t\tconst dragBehavior = obstacle.behaviors[\"Перетаскивание\"];",
						"",
						"\t\tif (dragBehavior) {",
						"\t\t\tdragBehavior.isEnabled = status;",
						"\t\t}",
						"\t}",
						"}",
						"",
						"function checkLevelTransition(player) {",
						"\tconst door = runtime.objects.Door.getFirstInstance();",
						"\tif (!door) return;",
						"",
						"\tconst playerBox = player.getBoundingBox();",
						"\tconst doorBox = door.getBoundingBox();",
						"",
						"\tconst overlaps =",
						"\t\tplayerBox.right > doorBox.left &&",
						"\t\tplayerBox.left < doorBox.right &&",
						"\t\tplayerBox.bottom > doorBox.top &&",
						"\t\tplayerBox.top < doorBox.bottom;",
						"",
						"\tif (overlaps) {",
						"\t\tconst currentLayout = runtime.layout.name;",
						"\t\tconst nextLayout = nextLevels[currentLayout];",
						"",
						"\t\tif (nextLayout) {",
						"\t\t\tlevelChanging = true;",
						"\t\t\truntime.goToLayout(nextLayout);",
						"\t\t}",
						"\t}",
						"}",
						"",
						"runtime.addEventListener(\"tick\", () => {",
						"\tif (levelChanging) return;",
						"",
						"\tconst player = runtime.objects.Player.getFirstInstance();",
						"\tconst grounds = runtime.objects.Ground.getAllInstances();",
						"\tconst boxes = runtime.objects.Box.getAllInstances();",
						"",
						"\tif (!player || (grounds.length === 0 && boxes.length === 0)) return;",
						"",
						"\tconst deltaTime = runtime.dt;",
						"",
						"\tconst solidObstacles = [...grounds, ...boxes];",
						"\tconst groundsNPlayer = [...grounds, player];",
						"\t",
						"\tmoveAndJump(deltaTime);",
						"",
						"\tcheckPlayerCollision(",
						"\t\tplayer,",
						"\t\tsolidObstacles,",
						"\t\tboxes,",
						"\t\tdeltaTime,",
						"\t\tmovementX",
						"\t);",
						"",
						"\trestrictBoxesAboveGround(boxes, groundsNPlayer);",
						"",
						"\tcheckLevelTransition(player);",
						"});"
					]
				}
			],
			"sid": 139123869015157
		}
	],
	"sid": 404297600729732
}