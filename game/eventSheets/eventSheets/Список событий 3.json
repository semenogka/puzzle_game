{
	"name": "Список событий 3",
	"events": [
		{
			"eventType": "block",
			"conditions": [
				{
					"id": "on-start-of-layout",
					"objectClass": "System",
					"sid": 239527592965102
				}
			],
			"actions": [
				{
					"type": "script",
					"language": "javascript",
					"script": [
						"const keys = new Set();",
						"",
						"let velocityY = 0;",
						"let onGround = false;",
						"let levelChanging = false;",
						"",
						"const speed = 600;",
						"const jumpForce = 1000;",
						"const gravity = 2000;",
						"",
						"const nextLevels = {",
						"\t\"Level3\": \"Level4\"",
						"};",
						"",
						"runtime.addEventListener(\"keydown\", e => {",
						"\tkeys.add(e.code.toLowerCase());",
						"\tkeys.add(e.key.toLowerCase());",
						"});",
						"",
						"runtime.addEventListener(\"keyup\", e => {",
						"\tkeys.delete(e.code.toLowerCase());",
						"\tkeys.delete(e.key.toLowerCase());",
						"});",
						"",
						"function handleMovement(player, deltaTime) {",
						"\tif (keys.has(\"keya\") || keys.has(\"arrowleft\")) {",
						"\t\tplayer.x -= speed * deltaTime;",
						"\t}",
						"",
						"\tif (keys.has(\"keyd\") || keys.has(\"arrowright\")) {",
						"\t\tplayer.x += speed * deltaTime;",
						"\t}",
						"}",
						"",
						"function handleJump() {",
						"\tif (",
						"\t\t(keys.has(\"space\") || keys.has(\"keyw\") || keys.has(\"arrowup\")) &&",
						"\t\tonGround",
						"\t) {",
						"\t\tvelocityY = -jumpForce;",
						"\t\tonGround = false;",
						"\t}",
						"}",
						"",
						"function enableOrDisableDragDrop(boxes, obstacle, status) {",
						"\tif (boxes.includes(obstacle)) {",
						"\t\tobstacle.behaviors[\"Перетаскивание\"].isEnabled = status;",
						"\t}",
						"}",
						"",
						"function checkGroundCollision(player, grounds, boxes, previousBottom, currentBottom) {",
						"\tonGround = false;",
						"",
						"\tconst solidObstacles = [...grounds, ...boxes];",
						"",
						"\tfor (const obstacle of solidObstacles) {",
						"\t\tconst obsBox = obstacle.getBoundingBox();",
						"\t\tconst playerBoxAfter = player.getBoundingBox();",
						"",
						"\t\tconst overlapsX =",
						"\t\t\tplayerBoxAfter.right > obsBox.left &&",
						"\t\t\tplayerBoxAfter.left < obsBox.right;",
						"",
						"\t\tif (",
						"\t\t\tvelocityY >= 0 &&",
						"\t\t\tpreviousBottom <= obsBox.top + 8 &&",
						"\t\t\tcurrentBottom >= obsBox.top &&",
						"\t\t\toverlapsX",
						"\t\t) {",
						"\t\t\tplayer.y -= currentBottom - obsBox.top;",
						"\t\t\tvelocityY = 0;",
						"\t\t\tonGround = true;",
						"",
						"\t\t\tenableOrDisableDragDrop(boxes, obstacle, false);",
						"\t\t\t",
						"\t\t\tbreak;",
						"\t\t}else {",
						"\t\t\tenableOrDisableDragDrop(boxes, obstacle, true);",
						"\t\t}",
						"\t}",
						"}",
						"",
						"function checkLevelTransition(player) {",
						"\tif (player.getBoundingBox().right >= runtime.layout.width - 10) {",
						"\t\tconst currentLayout = runtime.layout.name;",
						"\t\tconst nextLayout = nextLevels[currentLayout];",
						"",
						"\t\tif (nextLayout) {",
						"\t\t\tlevelChanging = true;",
						"\t\t\truntime.goToLayout(nextLayout);",
						"\t\t}",
						"\t}",
						"}",
						"",
						"runtime.addEventListener(\"tick\", () => {",
						"\tif (levelChanging) return;",
						"",
						"\tconst player = runtime.objects.Player.getFirstInstance();",
						"\tconst grounds = runtime.objects.Ground.getAllInstances();",
						"\tconst boxes = runtime.objects.Box.getAllInstances();",
						"",
						"\tif (!player || (grounds.length === 0 && boxes.length === 0)) return;",
						"",
						"\tconst deltaTime = runtime.dt;",
						"",
						"\thandleMovement(player, deltaTime);",
						"\thandleJump();",
						"",
						"\tconst previousBottom = player.getBoundingBox().bottom;",
						"",
						"\tvelocityY += gravity * deltaTime;",
						"\tplayer.y += velocityY * deltaTime;",
						"",
						"\tconst currentBottom = player.getBoundingBox().bottom;",
						"",
						"\tcheckGroundCollision(player, grounds, boxes, previousBottom, currentBottom);",
						"\tcheckLevelTransition(player);",
						"});"
					]
				}
			],
			"sid": 139123869015157
		}
	],
	"sid": 404297600729732
}