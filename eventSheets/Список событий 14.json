{
	"name": "Список событий 14",
	"events": [
		{
			"eventType": "block",
			"conditions": [
				{
					"id": "on-start-of-layout",
					"objectClass": "System",
					"sid": 891140000000102
				}
			],
			"actions": [
				{
					"type": "script",
					"language": "javascript",
					"script": [
						"const playerManager = globalThis.PlayerManager;",
						"const gravityManager = globalThis.GravityManager;",
						"const fallManager = globalThis.FallManager;",
						"const musicManager = globalThis.MusicManager;",
						"const soundManager = globalThis.SoundManager;",
						"const transitionManager = globalThis.TransitionManager;",
						"const effectManager = globalThis.EffectManager;",
						"const crushManager = globalThis.CrushManager;",
						"",
						"if (!playerManager || !gravityManager || !fallManager) {",
						"\tthrow new Error(\"Один из менеджеров не инициализирован\");",
						"}",
						"",
						"if (crushManager) crushManager.active = false;",
						"",
						"const player = runtime.objects.Player?.getFirstInstance();",
						"const grounds = runtime.objects.Ground?.getAllInstances() || [];",
						"const cannons = runtime.objects[\"пушка\"]?.getAllInstances() || [];",
						"const buttons = runtime.objects[\"ненажатая\"]?.getAllInstances() || [];",
						"const door = runtime.objects.Door?.getFirstInstance();",
						"",
						"function hasTag(inst, tag) {",
						"\tif (!inst || !tag) return false;",
						"\tconst lower = String(tag).toLowerCase();",
						"\tif (typeof inst.hasTag === \"function\" && inst.hasTag(tag)) return true;",
						"\tif (typeof inst.getAllTags === \"function\") {",
						"\t\tfor (const t of inst.getAllTags()) {",
						"\t\t\tif (String(t).toLowerCase() === lower) return true;",
						"\t\t}",
						"\t}",
						"\tconst raw = inst.tags ?? inst.tag;",
						"\tif (typeof raw === \"string\") {",
						"\t\treturn raw.toLowerCase().split(/\\s+/).includes(lower);",
						"\t}",
						"\treturn false;",
						"}",
						"",
						"// В Construct 3 теги с пробелами ('синяя кнопка') хранятся как отдельные токены",
						"function matchesTag(inst, exactTag) {",
						"\tif (!inst || !exactTag) return false;",
						"\tconst parts = String(exactTag).trim().split(/\\s+/);",
						"\tfor (const part of parts) {",
						"\t\tif (!hasTag(inst, part)) return false;",
						"\t}",
						"\treturn parts.length > 0;",
						"}",
						"",
						"const blueButtons = buttons.filter(b => matchesTag(b, \"синяя кнопка\"));",
						"const redButtons = buttons.filter(b => matchesTag(b, \"красная кнопка\"));",
						"const greenButtons = buttons.filter(b => matchesTag(b, \"зеленая кнопка\"));",
						"",
						"const blueDoors = cannons.filter(c => matchesTag(c, \"синяя дверь\"));",
						"const redDoors = cannons.filter(c => matchesTag(c, \"красная дверь\"));",
						"const greenDoors = cannons.filter(c => matchesTag(c, \"зеленая дверь\"));",
						"",
						"const lift = grounds.find(g => hasTag(g, \"лифт\"));",
						"const liftStartY = lift ? lift.y : 0;",
						"const liftMaxY = lift ? liftStartY + 275 : 0;",
						"const liftSpeed = 95;",
						"",
						"let levelChanging = false;",
						"let isDead = false;",
						"let flipsLeft = 4;",
						"let prevSign = 1;",
						"",
						"const fallLimit = 1200;",
						"const nextLevels = {",
						"\t\"Level14\": \"Level15\"",
						"};",
						"",
						"playerManager.initialize(runtime);",
						"musicManager?.start(runtime, \"bgm.webm\");",
						"soundManager?.initialize(runtime);",
						"transitionManager?.initialize(runtime, player);",
						"",
						"gravityManager.initialize(runtime, {",
						"\tflipPlayer: true,",
						"\tobjectTag: \"gravity\",",
						"\tobjectGravity: 1400,",
						"\tpushBoxes: false",
						"});",
						"gravityManager.bind(player);",
						"prevSign = gravityManager.playerSign;",
						"",
						"function formatFlips(count) {",
						"\tif (count === 1) return \"осталась 1 смена\";",
						"\tif (count >= 2 && count <= 4) return `осталось ${count} смены`;",
						"\treturn `осталось ${count} смен`;",
						"}",
						"",
						"let flipsLabel = null;",
						"if (runtime.objects[\"Текст\"]) {",
						"\ttry {",
						"\t\tflipsLabel = runtime.objects[\"Текст\"].createInstance(0, 1520, 62);",
						"\t\tif (flipsLabel) {",
						"\t\t\tflipsLabel.width = 360;",
						"\t\t\tflipsLabel.height = 56;",
						"\t\t\tflipsLabel.opacity = 1;",
						"\t\t\ttry { flipsLabel.text = formatFlips(flipsLeft); } catch (e) {}",
						"\t\t\ttry {",
						"\t\t\t\tif (\"fontFace\" in flipsLabel) flipsLabel.fontFace = \"Correction Brush\";",
						"\t\t\t\tif (\"sizePt\" in flipsLabel) flipsLabel.sizePt = 24;",
						"\t\t\t} catch (e) {}",
						"\t\t\tif (\"horizontalAlign\" in flipsLabel) flipsLabel.horizontalAlign = \"right\";",
						"\t\t\tif (\"verticalAlign\" in flipsLabel) flipsLabel.verticalAlign = \"center\";",
						"\t\t\tif (\"fontColor\" in flipsLabel) flipsLabel.fontColor = [0.96, 0.96, 0.94];",
						"\t\t\tif (typeof flipsLabel.moveToTop === \"function\") flipsLabel.moveToTop();",
						"\t\t}",
						"\t} catch (e) {}",
						"}",
						"",
						"function updateFlipsLabel() {",
						"\tif (!flipsLabel) return;",
						"\ttry {",
						"\t\tflipsLabel.text = formatFlips(flipsLeft);",
						"\t\tif (flipsLeft === 0 && \"fontColor\" in flipsLabel) {",
						"\t\t\tflipsLabel.fontColor = [0.95, 0.45, 0.42];",
						"\t\t}",
						"\t} catch (e) {}",
						"}",
						"",
						"function overlaps(a, b, pad = 0) {",
						"\tif (!a || !b || a.isVisible === false || b.isVisible === false) return false;",
						"\tconst ba = a.getBoundingBox();",
						"\tconst bb = b.getBoundingBox();",
						"\treturn ba.right + pad > bb.left &&",
						"\t       ba.left - pad < bb.right &&",
						"\t       ba.bottom + pad > bb.top &&",
						"\t       ba.top - pad < bb.bottom;",
						"}",
						"",
						"function checkColorGroup(groupButtons, groupDoors) {",
						"\tif (!player) return;",
						"\tfor (const btn of groupButtons) {",
						"\t\tif (btn.isVisible === false) continue;",
						"\t\tif (!overlaps(player, btn, 6)) continue;",
						"\t\tbtn.isVisible = false;",
						"\t\teffectManager?.button(runtime, btn);",
						"\t\tsoundManager?.play(\"zoomOut\");",
						"\t\tfor (const doorCannon of groupDoors) {",
						"\t\t\tif (doorCannon.isVisible !== false) {",
						"\t\t\t\tdoorCannon.isVisible = false;",
						"\t\t\t\teffectManager?.gate(runtime, doorCannon);",
						"\t\t\t}",
						"\t\t}",
						"\t}",
						"}",
						"",
						"function updateLift(dt) {",
						"\tif (!lift || !player) return;",
						"\tconst pBox = player.getBoundingBox();",
						"\tconst lBox = lift.getBoundingBox();",
						"\tconst ox = Math.min(pBox.right, lBox.right) - Math.max(pBox.left, lBox.left);",
						"\tconst standingOnLift = gravityManager.playerSign === 1 &&",
						"\t                       ox > 8 &&",
						"\t                       pBox.bottom >= lBox.top - 10 &&",
						"\t                       pBox.bottom <= lBox.top + 14;",
						"",
						"\tconst oldY = lift.y;",
						"\tif (standingOnLift) {",
						"\t\tlift.y = Math.min(liftMaxY, lift.y + liftSpeed * dt);",
						"\t\tconst dy = lift.y - oldY;",
						"\t\tif (dy > 0) player.y += dy;",
						"\t} else {",
						"\t\tlift.y = Math.max(liftStartY, lift.y - liftSpeed * dt);",
						"\t}",
						"}",
						"",
						"function getActiveSolids() {",
						"\tconst list = [];",
						"\tfor (const g of grounds) {",
						"\t\tif (g && g.isVisible !== false) list.push(g);",
						"\t}",
						"\tfor (const c of cannons) {",
						"\t\tif (c && c.isVisible !== false) list.push(c);",
						"\t}",
						"\treturn list;",
						"}",
						"",
						"function checkLevelTransition() {",
						"\tif (levelChanging || isDead || playerManager.crushed || !player || !door) return;",
						"\tif (!overlaps(player, door)) return;",
						"\tif (gravityManager.holdsDoor(player)) return;",
						"\tconst nextLayout = nextLevels[runtime.layout.name];",
						"\tif (!nextLayout) return;",
						"\tlevelChanging = true;",
						"\tplayerManager.velocityX = 0;",
						"\tplayerManager.velocityY = 0;",
						"\ttransitionManager?.start(runtime, player, nextLayout);",
						"}",
						"",
						"globalThis.RuntimeLoop.set(() => {",
						"\tif (transitionManager?.entryActive || isDead || levelChanging) return;",
						"\tif (!player || grounds.length === 0) return;",
						"",
						"\tconst deltaTime = Math.min(runtime.dt, 0.05);",
						"\tconst solids = getActiveSolids();",
						"",
						"\tif (flipsLeft <= 0) {",
						"\t\tgravityManager.prevFlipKey = true;",
						"\t\tif (!gravityManager.awaitLanding) gravityManager.flipLock = 1;",
						"\t}",
						"",
						"\tgravityManager.preUpdate(deltaTime, solids);",
						"",
						"\tif (gravityManager.playerSign !== prevSign) {",
						"\t\tprevSign = gravityManager.playerSign;",
						"\t\tflipsLeft = Math.max(0, flipsLeft - 1);",
						"\t\tupdateFlipsLabel();",
						"\t}",
						"",
						"\tplayerManager.update(player, solids, [], deltaTime);",
						"\tgravityManager.postUpdate(player, solids);",
						"",
						"\tupdateLift(deltaTime);",
						"\tcheckColorGroup(blueButtons, blueDoors);",
						"\tcheckColorGroup(redButtons, redDoors);",
						"\tcheckColorGroup(greenButtons, greenDoors);",
						"\tcheckLevelTransition();",
						"",
						"\tisDead = fallManager.checkPlayerFall(",
						"\t\truntime,",
						"\t\tglobalThis.GameOverManager,",
						"\t\tplayerManager,",
						"\t\tisDead,",
						"\t\tplayer,",
						"\t\tfallLimit",
						"\t);",
						"});"
					]
				}
			],
			"sid": 891140000000101
		}
	],
	"sid": 891140000000100
}