{
	"name": "Список событий 16",
	"events": [
		{
			"eventType": "block",
			"conditions": [
				{
					"id": "on-start-of-layout",
					"objectClass": "System",
					"sid": 916160000000102
				}
			],
			"actions": [
				{
					"type": "script",
					"language": "javascript",
					"script": [
						"const playerManager = globalThis.PlayerManager;",
						"const glasses = globalThis.GlassesManager;",
						"const fallManager = globalThis.FallManager;",
						"",
						"if (!playerManager || !glasses || !fallManager) {",
						"\tthrow new Error(\"Один из менеджеров не инициализирован\");",
						"}",
						"",
						"const player = runtime.objects.Player.getFirstInstance();",
						"const grounds = runtime.objects.Ground.getAllInstances();",
						"",
						"let levelChanging = false;",
						"let isDead = false;",
						"",
						"const fallLimit = 1200;",
						"",
						"playerManager.initialize(runtime);",
						"globalThis.MusicManager.start(runtime, \"bgm.webm\");",
						"globalThis.SoundManager.initialize(runtime);",
						"glasses.initialize(runtime);",
						"globalThis.TransitionManager.initialize(runtime, player);",
						"",
						"function checkLevelTransition() {",
						"\tif (levelChanging || isDead || playerManager.crushed || !player) return;",
						"",
						"\tconst door = runtime.objects.Door.getFirstInstance();",
						"\tif (!door) return;",
						"",
						"\tconst doorBox = door.getBoundingBox();",
						"\tconst doorLeft = doorBox.left;",
						"\tconst doorRight = doorBox.right;",
						"\tconst doorTop = doorBox.top;",
						"\tconst doorBottom = doorBox.bottom;",
						"\tconst playerBox = player.getBoundingBox();",
						"",
						"\tconst overlaps =",
						"\t\tplayerBox.right > doorLeft &&",
						"\t\tplayerBox.left < doorRight &&",
						"\t\tplayerBox.bottom > doorTop &&",
						"\t\tplayerBox.top < doorBottom;",
						"",
						"\tif (!overlaps) return;",
						"",
						"\tlevelChanging = true;",
						"\tplayerManager.velocityY = 0;",
						"\tglobalThis.TransitionManager.start(runtime, player, \"Level17\");",
						"}",
						"",
						"globalThis.RuntimeLoop.set(() => {",
						"\tif (globalThis.TransitionManager.entryActive || isDead || levelChanging) return;",
						"\tif (!player) return;",
						"",
						"\tconst deltaTime = runtime.dt;",
						"",
						"\tglasses.preUpdate(deltaTime);",
						"\tplayerManager.update(",
						"\t\tplayer,",
						"\t\tglasses.solids(grounds),",
						"\t\t[],",
						"\t\tdeltaTime",
						"\t);",
						"",
						"\tcheckLevelTransition();",
						"",
						"\tif (fallManager.checkPlayerFall(runtime, globalThis.GameOverManager, playerManager, isDead, player, fallLimit)) {",
						"\t\tisDead = true;",
						"\t}",
						"});",
						""
					]
				}
			],
			"sid": 916160000000101
		}
	],
	"sid": 916160000000100
}