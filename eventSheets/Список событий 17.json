{
	"name": "Список событий 17",
	"events": [
		{
			"eventType": "block",
			"conditions": [
				{
					"id": "on-start-of-layout",
					"objectClass": "System",
					"sid": 917170000000102
				}
			],
			"actions": [
				{
					"type": "script",
					"language": "javascript",
					"script": [
						"const playerManager = globalThis.PlayerManager;",
						"const glasses = globalThis.GlassesManager;",
						"const fallManager = globalThis.FallManager;",
						"const effectManager = globalThis.EffectManager;",
						"const soundManager = globalThis.SoundManager;",
						"",
						"if (!playerManager || !glasses || !fallManager) {",
						"\tthrow new Error(\"Один из менеджеров не инициализирован\");",
						"}",
						"",
						"const player = runtime.objects.Player.getFirstInstance();",
						"const allGrounds = runtime.objects.Ground.getAllInstances();",
						"const door = runtime.objects.Door?.getFirstInstance();",
						"const lock = runtime.objects[\"замок\"]?.getFirstInstance();",
						"const ball = runtime.objects.Ball?.getFirstInstance() || runtime.objects.Dot?.getFirstInstance();",
						"const texts = runtime.objects[\"Текст\"]?.getAllInstances() || [];",
						"",
						"function hasTag(inst, tag) {",
						"\tif (!inst || !tag) return false;",
						"\tif (typeof inst.hasTag === \"function\" && inst.hasTag(tag)) return true;",
						"\tconst raw = inst.tags ?? inst.tag ?? \"\";",
						"\tconst list = Array.isArray(raw) ? raw : String(raw).split(/\\s+/);",
						"\treturn list.includes(tag);",
						"}",
						"",
						"const livesText = texts.find(t => hasTag(t, \"lives\"));",
						"const mazeCenter = { x: 960, y: 395 };",
						"const maxTilt = 0.34;",
						"const tiltSpeed = 1.05;",
						"let mazeAngle = 0;",
						"",
						"const playerSolids = [];",
						"const mazePieces = [];",
						"",
						"for (const g of allGrounds) {",
						"\tif (hasTag(g, \"maze\")) {",
						"\t\tconst role = hasTag(g, \"pink\") ? \"pink\" : (hasTag(g, \"plain\") ? \"plain\" : \"both\");",
						"\t\tmazePieces.push({",
						"\t\t\tinst: g,",
						"\t\t\tlx: g.x - mazeCenter.x,",
						"\t\t\tly: g.y - mazeCenter.y,",
						"\t\t\thw: g.width / 2,",
						"\t\t\thh: g.height / 2,",
						"\t\t\trole,",
						"\t\t\tisSpike: hasTag(g, \"spike\")",
						"\t\t});",
						"\t} else if (!hasTag(g, \"container\")) {",
						"\t\tplayerSolids.push(g);",
						"\t}",
						"}",
						"",
						"const ballRadius = ball ? ball.width / 2 : 15;",
						"const ballStart = {",
						"\tlx: ball ? ball.x - mazeCenter.x : -260,",
						"\tly: ball ? ball.y - mazeCenter.y : -305",
						"};",
						"",
						"let ballLx = ballStart.lx;",
						"let ballLy = ballStart.ly;",
						"let ballVx = 0;",
						"let ballVy = 0;",
						"let ballSpin = 0;",
						"let lives = 3;",
						"let ballInContainer = false;",
						"let doorUnlocked = !lock;",
						"let levelChanging = false;",
						"let isDead = false;",
						"const fallLimit = 1200;",
						"const ballGravity = 1650;",
						"",
						"const containerZone = {",
						"\tleft: 904,",
						"\tright: 1016,",
						"\ttop: 820,",
						"\tbottom: 874",
						"};",
						"",
						"playerManager.initialize(runtime);",
						"globalThis.MusicManager.start(runtime, \"bgm.webm\");",
						"soundManager?.initialize(runtime);",
						"glasses.initialize(runtime);",
						"globalThis.TransitionManager.initialize(runtime, player);",
						"",
						"function updateLivesLabel() {",
						"\tif (livesText) livesText.text = `Попытки: ${lives}`;",
						"}",
						"",
						"function isPieceActive(piece) {",
						"\tif (piece.role === \"plain\") return glasses.shown < 0.85;",
						"\tif (piece.role === \"pink\") return glasses.shown > 0.2;",
						"\treturn true;",
						"}",
						"",
						"function resetBall(broken) {",
						"\tif (broken && ball) {",
						"\t\teffectManager?.spike(runtime, ball);",
						"\t\tsoundManager?.play(\"frameFall\");",
						"\t\tlives -= 1;",
						"\t\tupdateLivesLabel();",
						"\t\tif (lives <= 0) {",
						"\t\t\tisDead = true;",
						"\t\t\tball.isVisible = false;",
						"\t\t\tplayerManager.velocityX = 0;",
						"\t\t\tplayerManager.velocityY = 0;",
						"\t\t\tglobalThis.GameOverManager?.show(runtime, player, \"Шар разбит\");",
						"\t\t\treturn;",
						"\t\t}",
						"\t}",
						"\tballLx = ballStart.lx;",
						"\tballLy = ballStart.ly;",
						"\tballVx = 0;",
						"\tballVy = 0;",
						"\tballSpin = 0;",
						"}",
						"",
						"function updateMazeTransforms() {",
						"\tconst cos = Math.cos(mazeAngle);",
						"\tconst sin = Math.sin(mazeAngle);",
						"\tfor (const p of mazePieces) {",
						"\t\tp.inst.x = mazeCenter.x + p.lx * cos - p.ly * sin;",
						"\t\tp.inst.y = mazeCenter.y + p.lx * sin + p.ly * cos;",
						"\t\tp.inst.angle = mazeAngle;",
						"\t}",
						"}",
						"",
						"function placeBallInMaze() {",
						"\tif (!ball) return;",
						"\tconst cos = Math.cos(mazeAngle);",
						"\tconst sin = Math.sin(mazeAngle);",
						"\tball.x = mazeCenter.x + ballLx * cos - ballLy * sin;",
						"\tball.y = mazeCenter.y + ballLx * sin + ballLy * cos;",
						"\tball.angle = mazeAngle + ballSpin;",
						"}",
						"",
						"function updateMazeTilt(dt) {",
						"\tconst keys = playerManager.keys;",
						"\tlet targetAngle = 0;",
						"\tif (keys.has(\"keya\") || keys.has(\"arrowleft\")) targetAngle -= maxTilt;",
						"\tif (keys.has(\"keyd\") || keys.has(\"arrowright\")) targetAngle += maxTilt;",
						"\tconst diff = targetAngle - mazeAngle;",
						"\tconst maxStep = tiltSpeed * dt;",
						"\tif (Math.abs(diff) <= maxStep) mazeAngle = targetAngle;",
						"\telse mazeAngle += Math.sign(diff) * maxStep;",
						"}",
						"",
						"function stepBallInMaze(dt) {",
						"\tif (!ball || ballInContainer || isDead) return;",
						"",
						"\tconst gx = ballGravity * Math.sin(mazeAngle);",
						"\tconst gy = ballGravity * Math.cos(mazeAngle);",
						"\tballVx += gx * dt;",
						"\tballVy += gy * dt;",
						"\tballVx *= Math.pow(0.988, dt * 60);",
						"\tballVx = Math.min(950, Math.max(-950, ballVx));",
						"\tballVy = Math.min(1100, Math.max(-1100, ballVy));",
						"",
						"\tballLx += ballVx * dt;",
						"\tballLy += ballVy * dt;",
						"\tballSpin += (ballVx / ballRadius) * dt;",
						"",
						"\tfor (let iter = 0; iter < 4; iter++) {",
						"\t\tfor (const p of mazePieces) {",
						"\t\t\tif (!isPieceActive(p)) continue;",
						"\t\t\tconst closestX = Math.max(p.lx - p.hw, Math.min(ballLx, p.lx + p.hw));",
						"\t\t\tconst closestY = Math.max(p.ly - p.hh, Math.min(ballLy, p.ly + p.hh));",
						"\t\t\tconst dx = ballLx - closestX;",
						"\t\t\tconst dy = ballLy - closestY;",
						"\t\t\tconst distSq = dx * dx + dy * dy;",
						"\t\t\tif (distSq >= ballRadius * ballRadius) continue;",
						"",
						"\t\t\tif (p.isSpike) {",
						"\t\t\t\tplaceBallInMaze();",
						"\t\t\t\tresetBall(true);",
						"\t\t\t\tif (!isDead) placeBallInMaze();",
						"\t\t\t\treturn;",
						"\t\t\t}",
						"",
						"\t\t\tconst dist = Math.sqrt(distSq);",
						"\t\t\tlet nx = 0;",
						"\t\t\tlet ny = 0;",
						"\t\t\tlet pen = 0;",
						"\t\t\tif (dist > 0.0001) {",
						"\t\t\t\tnx = dx / dist;",
						"\t\t\t\tny = dy / dist;",
						"\t\t\t\tpen = ballRadius - dist;",
						"\t\t\t} else {",
						"\t\t\t\tconst ox = p.hw + ballRadius - Math.abs(ballLx - p.lx);",
						"\t\t\t\tconst oy = p.hh + ballRadius - Math.abs(ballLy - p.ly);",
						"\t\t\t\tif (ox < oy) {",
						"\t\t\t\t\tnx = ballLx < p.lx ? -1 : 1;",
						"\t\t\t\t\tpen = ox;",
						"\t\t\t\t} else {",
						"\t\t\t\t\tny = ballLy < p.ly ? -1 : 1;",
						"\t\t\t\t\tpen = oy;",
						"\t\t\t\t}",
						"\t\t\t}",
						"",
						"\t\t\tballLx += nx * pen;",
						"\t\t\tballLy += ny * pen;",
						"\t\t\tconst vn = ballVx * nx + ballVy * ny;",
						"\t\t\tif (vn < 0) {",
						"\t\t\t\tballVx -= 1.15 * vn * nx;",
						"\t\t\t\tballVy -= 1.15 * vn * ny;",
						"\t\t\t}",
						"\t\t}",
						"\t}",
						"",
						"\tplaceBallInMaze();",
						"",
						"\tif (ball.x >= containerZone.left && ball.x <= containerZone.right &&",
						"\t    ball.y >= containerZone.top && ball.y <= containerZone.bottom) {",
						"\t\tballInContainer = true;",
						"\t\tball.x = 960;",
						"\t\tball.y = 857;",
						"\t\tball.angle = 0;",
						"\t\tif (!doorUnlocked) {",
						"\t\t\tdoorUnlocked = true;",
						"\t\t\tif (lock) {",
						"\t\t\t\tlock.isVisible = false;",
						"\t\t\t\teffectManager?.impact(runtime, lock, 1);",
						"\t\t\t}",
						"\t\t\tsoundManager?.play(\"frameFall\");",
						"\t\t}",
						"\t\treturn;",
						"\t}",
						"",
						"\tif (ball.y > 920 || ball.x < 400 || ball.x > 1520) {",
						"\t\tresetBall(true);",
						"\t\tif (!isDead) placeBallInMaze();",
						"\t}",
						"}",
						"",
						"function checkLevelTransition() {",
						"\tif (levelChanging || isDead || playerManager.crushed || !player || !door) return;",
						"\tif (!doorUnlocked) return;",
						"",
						"\tconst doorBox = door.getBoundingBox();",
						"\tconst playerBox = player.getBoundingBox();",
						"\tconst overlaps =",
						"\t\tplayerBox.right > doorBox.left &&",
						"\t\tplayerBox.left < doorBox.right &&",
						"\t\tplayerBox.bottom > doorBox.top &&",
						"\t\tplayerBox.top < doorBox.bottom;",
						"",
						"\tif (!overlaps) return;",
						"",
						"\tlevelChanging = true;",
						"\tplayerManager.velocityY = 0;",
						"\tglobalThis.TransitionManager.start(runtime, player, \"Menu\");",
						"}",
						"",
						"updateLivesLabel();",
						"updateMazeTransforms();",
						"placeBallInMaze();",
						"",
						"globalThis.RuntimeLoop.set(() => {",
						"\tif (globalThis.TransitionManager.entryActive || isDead || levelChanging) return;",
						"\tif (!player) return;",
						"",
						"\tconst deltaTime = Math.min(runtime.dt, 0.05);",
						"",
						"\tglasses.preUpdate(deltaTime);",
						"\tupdateMazeTilt(deltaTime);",
						"\tupdateMazeTransforms();",
						"\tstepBallInMaze(deltaTime);",
						"\tif (isDead) return;",
						"\tplayerManager.update(player, playerSolids, [], deltaTime);",
						"",
						"\tcheckLevelTransition();",
						"",
						"\tif (fallManager.checkPlayerFall(runtime, globalThis.GameOverManager, playerManager, isDead, player, fallLimit)) {",
						"\t\tisDead = true;",
						"\t}",
						"});",
						""
					]
				}
			],
			"sid": 917170000000101
		}
	],
	"sid": 917170000000100
}
